---

<button class="ch-scroll-top fixed bottom-6 right-6 z-50 flex h-10 w-10 cursor-pointer items-center justify-center rounded-md border border-border/40 bg-card shadow-sm text-foreground hover:bg-muted hover:border-primary/20 transition-all duration-300 translate-y-10 opacity-0 pointer-events-none [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 [&.is-visible]:pointer-events-auto focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background">
  <span aria-hidden="true">↑</span>
  <span class="sr-only">Scroll to top</span>
</button>

<footer class="w-full bg-background border-t border-border/30 py-8 px-6 font-sans">
  <div class="max-w-[1400px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
    <span>© <span id="ch-year"></span> Continuum Agency Inc. All rights reserved. Made with love in Palo Alto, CA.</span>
    <div class="flex items-center gap-6">
      <nav class="flex items-center gap-6">
        <a href="/technology/" class="hover:text-primary transition-colors">Technology</a>
        <a href="/social-plus" class="hover:text-primary transition-colors">Social+</a>
      </nav>
      <div class="flex items-center gap-4 border-l border-border/20 pl-6 h-4">
        <a href="https://instagram.com/trycontinuum" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Instagram">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/continuum-agency" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" aria-label="LinkedIn">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Year
  const yearEl = document.getElementById("ch-year");
  if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

  // Scroll Top
  const scrollTopBtn = document.querySelector(".ch-scroll-top");
  window.addEventListener("scroll", () => {
    const y = window.scrollY || window.pageYOffset;
    if (scrollTopBtn) scrollTopBtn.classList.toggle("is-visible", y > 320);
  });
  
  if (scrollTopBtn) {
    scrollTopBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  // Smooth scroll for footer links
  document.querySelectorAll(".ch-footer-links a.js-scroll").forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href");
      if (!href || !href.startsWith("#")) return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      const rect = target.getBoundingClientRect();
      const offset = rect.top + window.scrollY - 64;
      window.scrollTo({ top: offset, behavior: "smooth" });
    });
  });
</script>
---
// Self-contained night footer, the same on every page: link columns, then the CONTINUUM
// wordmark as a bookend (static poster O, the hero's black hole at rest).
const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#organic', label: 'Organic+' },
      { href: '/#performance', label: 'Performance+' },
      { href: '/#automation', label: 'Creative Automation' },
      { href: '/#results', label: 'Results' },
      { href: '/#pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/blog/', label: 'Blog' },
      { href: '/technology/', label: 'Technology' },
      { href: '/social-plus', label: 'Social+ for Claude' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/press/', label: 'Press' },
      { href: '/podcasts/', label: 'Podcasts' },
      { href: '/#demo', label: 'Book a demo' },
    ],
  },
];
---

<button class="ch-scroll-top btn-fill [--btn-fill:oklch(40%_0.19_272)] fixed bottom-6 right-6 z-50 flex h-10 w-10 cursor-pointer items-center justify-center rounded-md border border-white/15 bg-[oklch(20%_0.01_285)] shadow-sm text-white hover:border-white/30 transition-[opacity,transform,visibility] duration-300 translate-y-10 opacity-0 invisible pointer-events-none [&.is-visible]:visible [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 [&.is-visible]:pointer-events-auto focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background">
  <span aria-hidden="true">↑</span>
  <span class="sr-only">Scroll to top</span>
</button>

<footer class="ch-footer dark relative overflow-hidden border-t border-white/10 bg-[var(--night)] font-sans text-white">
  <canvas class="ch-footer-stars" aria-hidden="true"></canvas>
  <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-10 pt-16 md:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] md:px-6">
    <div>
      <p class="font-[family-name:var(--font-futura)] text-lg font-bold tracking-[0.18em] text-[#f3efe6]">CONTINUUM</p>
      <p class="mt-3 max-w-[30ch] text-base text-white/70">The intelligent creative factory for performance marketers, designers, and agencies.</p>
      <p class="mt-6 font-mono text-xs text-white/50">Signal in. Asset live. Loop closed.</p>
      <div class="mt-6 flex items-center gap-4">
        <a href="https://instagram.com/trycontinuum" target="_blank" rel="noopener noreferrer" class="text-white/60 transition-colors hover:text-white" aria-label="Continuum on Instagram">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/continuum-agency" target="_blank" rel="noopener noreferrer" class="text-white/60 transition-colors hover:text-white" aria-label="Continuum on LinkedIn">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>
      </div>
    </div>

    {columns.map((col) => (
      <nav aria-label={col.title}>
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-white/45">{col.title}</p>
        <ul class="mt-4 space-y-3">
          {col.links.map((l) => (
            <li><a href={l.href} class="text-[15px] text-white/80 transition-colors hover:text-white">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <!-- Bookend: the wordmark from the hero, at rest -->
  <p aria-hidden="true" class="pointer-events-none mx-auto -mb-[0.18em] flex max-w-7xl select-none items-center justify-between px-4 font-[family-name:var(--font-futura)] text-[13.5vw] font-bold leading-none text-white/[0.07] md:px-6 xl:text-[11.5rem]">
    <span>C</span>
    <span class="footer-o pointer-events-auto block size-[0.8em] cursor-grab touch-none active:cursor-grabbing">
      <img src="/assets/hero/black-hole.webp" alt="" width="412" height="412" draggable="false" class="size-full rounded-full opacity-50 [mask-image:radial-gradient(closest-side,#000_70%,transparent)]" loading="lazy" decoding="async" />
    </span>
    <span>N</span><span>T</span><span>I</span><span>N</span><span>U</span><span>U</span><span>M</span>
  </p>

  <div class="relative border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between md:px-6">
      <p>© <span id="ch-year">2026</span> Continuum Agency Inc. Built in Palo Alto, CA.</p>
      <p>The intelligent creative factory.</p>
    </div>
  </div>
</footer>

<style>
  .ch-footer-stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Keep the link columns, wordmark, and legal bar above the star canvas. */
  .ch-footer-stars ~ * { position: relative; }

  /* The bookend O floats and breathes like the hero's; its spin is driven by the script below. */
  @media (prefers-reduced-motion: no-preference) {
    .footer-o img { animation: footer-o-float 7s ease-in-out infinite, footer-o-breathe 6s ease-in-out infinite; }
  }
  @keyframes footer-o-float {
    0%, 100% { translate: 0 -4px; }
    50% { translate: 0 4px; }
  }
  @keyframes footer-o-breathe {
    0%, 100% { scale: 1; }
    50% { scale: 1.02; }
  }
</style>

<script>
  const yearEl = document.getElementById("ch-year");
  if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

  // Scroll-to-top: visible after the first screen, hidden while the footer (which has its own
  // links) is on screen so it never covers footer content.
  const scrollTopBtn = document.querySelector(".ch-scroll-top");
  const footer = document.querySelector(".ch-footer");
  let pastTop = false;
  let footerVisible = false;
  const sync = () => scrollTopBtn?.classList.toggle("is-visible", pastTop && !footerVisible);
  const sentinel = document.createElement("div");
  sentinel.style.cssText = "position:absolute;top:320px;height:1px;width:1px;pointer-events:none";
  document.body.prepend(sentinel);
  new IntersectionObserver(([e]) => { pastTop = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(sentinel);
  if (footer) new IntersectionObserver(([e]) => { footerVisible = e.isIntersecting; sync(); }).observe(footer);

  scrollTopBtn?.addEventListener("click", () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  });

  // The bookend O turns slowly on its own axis (one lap every two minutes). Grab it to spin it:
  // it follows the pointer around its centre, keeps the flick's speed on release, then eases back
  // to the idle turn. Runs only while the footer is on screen; reduced motion drops the idle turn
  // and the momentum, so it moves only while dragged.
  const orb = document.querySelector<HTMLElement>(".footer-o");
  if (orb && footer) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const IDLE = still ? 0 : 3; // deg/s
    const FRICTION = 1.4; // 1/s: how fast a flick settles back to the idle turn
    let angle = 0, speed = IDLE, grab: number | null = null, lastAt = 0, raf = 0, onScreen = false;
    const bearing = (e: PointerEvent) => {
      const b = orb.getBoundingClientRect();
      return (Math.atan2(e.clientY - b.top - b.height / 2, e.clientX - b.left - b.width / 2) * 180) / Math.PI;
    };
    const paint = () => orb.style.setProperty("rotate", `${angle}deg`);
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - lastAt) / 1000);
      lastAt = now;
      if (grab === null) {
        speed += (IDLE - speed) * (1 - Math.exp(-dt * FRICTION));
        angle += speed * dt;
        paint();
      }
      if (onScreen && (grab !== null || speed !== 0)) raf = requestAnimationFrame(tick);
      else raf = 0;
    };
    const run = () => {
      if (raf || !onScreen) return;
      lastAt = performance.now();
      raf = requestAnimationFrame(tick);
    };
    orb.addEventListener("pointerdown", (e) => {
      orb.setPointerCapture(e.pointerId);
      grab = bearing(e);
      speed = 0;
      run();
    });
    orb.addEventListener("pointermove", (e) => {
      if (grab === null) return;
      const now = bearing(e);
      const delta = ((now - grab + 540) % 360) - 180; // shortest way round
      const dt = Math.max(0.008, (performance.now() - lastAt) / 1000);
      grab = now;
      angle += delta;
      speed = still ? 0 : Math.max(-720, Math.min(720, delta / dt));
      paint();
    });
    const drop = () => {
      grab = null;
      run();
    };
    orb.addEventListener("pointerup", drop);
    orb.addEventListener("pointercancel", drop);
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (onScreen) run();
    }).observe(orb);
  }

  // Twinkling star lights over the footer's night background. Each star pulses on
  // its own sine phase; paused offscreen, and a single static frame under
  // prefers-reduced-motion.
  const starCanvas = document.querySelector(".ch-footer-stars");
  if (starCanvas instanceof HTMLCanvasElement && footer) {
    const sctx = starCanvas.getContext("2d");
    if (sctx) {
      const reducedStars = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const TINTS = ["243,239,230", "243,239,230", "243,239,230", "191,234,242", "214,203,255"];
      const sstars = [];
      let sw = 0, sh = 0, sraf = 0, srunning = false, svisible = true;

      const ssize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const box = footer.getBoundingClientRect();
        sw = box.width;
        sh = box.height;
        starCanvas.width = Math.max(1, Math.round(sw * dpr));
        starCanvas.height = Math.max(1, Math.round(sh * dpr));
        sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const target = Math.round(Math.min(140, Math.max(40, (sw * sh) / 9000)));
        sstars.length = 0;
        for (let i = 0; i < target; i++) {
          sstars.push({
            x: Math.random() * sw,
            y: Math.random() * sh,
            r: 0.6 + Math.random() * 1.1,
            a: 0.3 + Math.random() * 0.6,
            p: Math.random() * Math.PI * 2,
            s: (Math.PI * 2) / (2000 + Math.random() * 3000),
            c: TINTS[(Math.random() * TINTS.length) | 0],
          });
        }
      };

      const sdraw = (now) => {
        sctx.clearRect(0, 0, sw, sh);
        for (const s of sstars) {
          const tw = 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(s.p + now * s.s));
          sctx.globalAlpha = s.a * tw;
          sctx.fillStyle = `rgb(${s.c})`;
          sctx.beginPath();
          sctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          sctx.fill();
        }
        sctx.globalAlpha = 1;
      };

      const stick = (now) => {
        sdraw(now);
        sraf = requestAnimationFrame(stick);
      };
      const syncStars = () => {
        const shouldRun = !reducedStars && svisible && !document.hidden;
        if (shouldRun === srunning) return;
        srunning = shouldRun;
        if (srunning) {
          sraf = requestAnimationFrame(stick);
        } else cancelAnimationFrame(sraf);
      };

      new ResizeObserver(() => {
        ssize();
        if (!srunning) sdraw(1200); // settled mid-twinkle frame when static
      }).observe(footer);
      new IntersectionObserver(([entry]) => {
        svisible = entry?.isIntersecting ?? true;
        syncStars();
      }).observe(footer);
      document.addEventListener("visibilitychange", syncStars);

      ssize();
      sdraw(1200);
      syncStars();
    }
  }
</script>

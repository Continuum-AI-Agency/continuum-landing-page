---
import { Image } from 'astro:assets';

const logoFiles = import.meta.glob('../assets/cliente_logos/*.{png,jpg,jpeg,svg,gif,webp}', { eager: true });

const logos = Object.entries(logoFiles)
  .filter(([path]) => {
    const filename = path.split('/').pop() || '';
    if (filename === 'ProptechLatam_Logo_color.png') return false;
    if (filename === 'image.png') return false;
    if (filename === 'La_liga_basquet.png') return false;
    return true;
  })
  .map(([path, module]: [string, any]) => {
    const filenameWithExt = path.split('/').pop() || '';
    const filename = filenameWithExt.split('.')[0] || 'Client';
    
    const brandName = filename
      .replace(/[-_]/g, ' ')
      .replace(/\blogo\b/gi, '')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/\b\w/g, (l) => l.toUpperCase());
    
    return {
      src: module.default,
      brandName
    };
  });

logos.sort((a, b) => a.brandName.localeCompare(b.brandName));

// Triple the logos for seamless infinite scroll
const tripleLogos = [...logos, ...logos, ...logos];

---

<section id="proof" class="relative py-32 bg-background z-10 border-y border-border/30">
  <div class="container mx-auto px-6 relative z-20">
    <!-- Header -->
    <div class="max-w-4xl mx-auto mb-16 text-center">
      <h2 class="mb-8 font-semibold text-foreground text-xl tracking-tight md:text-4xl font-display">
        <span class="text-muted-foreground/60">Trusted by experts.</span>
        <br />
        <span class="text-foreground">Used by leaders.</span>
      </h2>
    </div>
  </div>

  <!-- Full-width Logo Carousel -->
  <div class="w-full">
    <!-- Infinite Scroll Carousel with Logo Cards -->
    <div 
      class="py-12 overflow-hidden" 
      style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);"
    >
      <div class="logo-track flex items-center gap-6 md:gap-8">
        {tripleLogos.map((logo, index) => (
          <div class="flex items-center justify-center h-20 md:h-24 px-8 md:px-10 bg-card rounded-xl border border-border/40 shadow-[0_1px_3px_oklch(0%_0_0_/_40%),_inset_0_1px_0_oklch(100%_0_0_/_8%)] flex-shrink-0 hover:border-primary/30 transition-all duration-500 group">
            <Image
              src={logo.src}
              alt={`${logo.brandName} Logo`}
              class={`h-10 md:h-12 w-auto object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-105 ${logo.brandName.toLowerCase().includes('feva') || logo.brandName.toLowerCase().includes('privalia') ? 'invert brightness-200' : ''}`}
              loading={index < logos.length ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

    <!-- Metrics Section Moved to ProductBento -->
  </div>
</section>

<style>
  .logo-track {
    animation: scroll 35s linear infinite;
    width: max-content;
  }
  
  .logo-track:hover {
    animation-play-state: paused;
  }
  
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }
</style>

---
import { Image } from 'astro:assets';

const logoFiles = import.meta.glob('../assets/cliente_logos/*.{png,jpg,jpeg,svg,gif,webp}', { eager: true });

const logos = Object.entries(logoFiles).map(([path, module]: [string, any]) => {
  const filenameWithExt = path.split('/').pop() || '';
  const filename = filenameWithExt.split('.')[0] || 'Client';
  
  const brandName = filename
    .replace(/[-_]/g, ' ')
    .replace(/\blogo\b/gi, '')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/\b\w/g, (l) => l.toUpperCase());
  
  return {
    src: module.default,
    brandName
  };
});

logos.sort((a, b) => a.brandName.localeCompare(b.brandName));

// Triple the logos for seamless infinite scroll
const tripleLogos = [...logos, ...logos, ...logos];

---

<section id="proof" class="relative py-32 bg-[#0f172a] z-10 border-y border-white/5">
  <div class="container mx-auto px-6 relative z-20">
    <!-- Header -->
    <div class="max-w-4xl mx-auto mb-16 text-center">
      <h2 class="mb-8 font-medium text-white text-xl tracking-tight md:text-4xl font-futura">
        <span class="text-gray-500">Trusted by experts.</span>
        <br />
        <span class="font-bold text-white">Used by the leaders.</span>
      </h2>
    </div>
  </div>

  <!-- Full-width Logo Carousel -->
  <div class="w-full">
    <!-- Infinite Scroll Carousel with Logo Cards -->
    <div 
      class="py-12 overflow-hidden" 
      style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);"
    >
      <div class="logo-track flex items-center gap-6 md:gap-8">
        {tripleLogos.map((logo, index) => (
          <div class="flex items-center justify-center h-20 md:h-24 px-8 md:px-10 bg-[#e6edf3] rounded-2xl border border-[#d0d7de] shadow-sm flex-shrink-0 hover:shadow-md hover:border-[#afb8c1] transition-all duration-500 group">
            <Image
              src={logo.src}
              alt={`${logo.brandName} Logo`}
              class="h-10 md:h-12 w-auto object-contain mix-blend-multiply grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-110"
              loading={index < logos.length ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

    <!-- Metrics Section Moved to ProductBento -->
  </div>
</section>

<style>
  .font-futura {
    font-family: 'Futura Maxi', sans-serif;
  }
  
  .logo-track {
    animation: scroll 35s linear infinite;
    width: max-content;
  }
  
  .logo-track:hover {
    animation-play-state: paused;
  }
  
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }
</style>

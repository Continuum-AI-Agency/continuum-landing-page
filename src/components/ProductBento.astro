---
import { AnimatedBento } from './react/AnimatedBento';
import { BentoStudioCanvas } from './react/BentoStudioCanvas';
import { BentoSocialCalendar } from './react/BentoSocialCalendar';
import { BentoPerformanceChart } from './react/BentoPerformanceChart';
import { BentoPersonaCreative } from './react/BentoPersonaCreative';
import { BentoPersonaAgency } from './react/BentoPersonaAgency';
import Metrics from './Metrics.astro';

// Template Images
import imgRes1 from '../assets/Videos_templates/Resultado_1.jpg';
import imgRes2 from '../assets/Videos_templates/Resultado_2.jpg';
import imgRes3 from '../assets/Videos_templates/Resultado_3.jpg';

const resultImages = [imgRes1, imgRes2, imgRes3];
---

<section id="product" class="pb-24 pt-0 bg-slate-900 relative overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-blue-500/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mb-14 reveal">
      <h2 class="text-4xl md:text-6xl font-bold text-white mb-6 font-futura tracking-tight">
        The Creative <br/><span class="shimmer-text">Operating System</span>
      </h2>
      <p class="text-xl text-gray-400 font-raleway leading-relaxed">
        Continuum connects your data, brand, and media stack into a single, high-performance loop.
      </p>
    </div>

    <!-- MAIN BENTO GRID -->
    <div class="flex flex-col gap-6 w-full max-w-[1400px] mx-auto reveal">
      
      <!-- MAIN ANIMATED BENTO (USE CLIENT) -->
      <div class="w-full mb-12">
        <AnimatedBento client:load results={resultImages} />
      </div>

      <!-- Bottom Row: 3 Interactive Modules -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
        
        {/* SOCIAL+ */}
        <div class="flex flex-col rounded-3xl bg-white/[0.02] backdrop-blur-xl border border-white/5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] hover:border-purple-500/30 hover:shadow-[0_0_40px_-10px_rgba(163,113,247,0.15)] transition-all duration-500 group overflow-hidden h-[500px]">
          <div class="p-8 pb-4 flex-none">
             <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold mb-4 bg-purple-500/10 text-purple-400 border border-purple-500/20 tracking-wider">
               SOCIAL+
             </span>
             <h3 class="text-2xl font-bold text-white mb-2 tracking-tight">Always-on social.</h3>
             <p class="text-slate-400 text-sm font-raleway leading-relaxed">
               Never let your feeds go quiet. A steady stream of on-brand content mapped to your calendar.
             </p>
          </div>
          <div class="flex-grow relative border-t border-white/5 mt-4 bg-[#0d1117]/50">
             <BentoSocialCalendar client:visible />
          </div>
        </div>

        {/* STUDIO+ */}
        <div class="flex flex-col rounded-3xl bg-white/[0.02] backdrop-blur-xl border border-white/5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] hover:border-blue-500/30 hover:shadow-[0_0_40px_-10px_rgba(47,129,247,0.15)] transition-all duration-500 group overflow-hidden h-[500px]">
          <div class="p-8 pb-4 flex-none">
             <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold mb-4 bg-blue-500/10 text-blue-400 border border-blue-500/20 tracking-wider">
               STUDIO+
             </span>
             <h3 class="text-2xl font-bold text-white mb-2 tracking-tight">Template-driven scaling.</h3>
             <p class="text-slate-400 text-sm font-raleway leading-relaxed">
               Create once, ship everywhere. Automated assets built to scale perfectly for in-house studios.
             </p>
          </div>
          <div class="flex-grow relative border-t border-white/5 mt-4">
             <BentoStudioCanvas client:visible />
          </div>
        </div>

        {/* PERFORMANCE+ */}
        <div class="flex flex-col rounded-3xl bg-white/[0.02] backdrop-blur-xl border border-white/5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] hover:border-green-500/30 hover:shadow-[0_0_40px_-10px_rgba(57,211,83,0.15)] transition-all duration-500 group overflow-hidden h-[500px]">
          <div class="p-8 pb-4 flex-none">
             <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold mb-4 bg-green-500/10 text-green-400 border border-green-500/20 tracking-wider">
               PERFORMANCE+
             </span>
             <h3 class="text-2xl font-bold text-white mb-2 tracking-tight">Creative x media engine.</h3>
             <p class="text-slate-400 text-sm font-raleway leading-relaxed">
               Creative plugged directly into media spend. Optimize both ideas and budgets simultaneously.
             </p>
          </div>
          <div class="flex-grow relative border-t border-white/5 mt-4">
             <BentoPerformanceChart client:visible />
          </div>
        </div>

      </div>
    </div>

    <!-- METRICS -->
    <div class="mt-8 mb-4">
      <Metrics />
    </div>

    <!-- TARGET PERSONAS -->
    <div class="flex flex-col gap-6 reveal mt-10 max-w-[1400px] mx-auto">
      <BentoPersonaCreative client:visible />
      <BentoPersonaAgency client:visible />
    </div>
  </div>
</section>

<style>
  .font-futura {
    font-family: 'Futura Maxi', sans-serif;
  }
  .font-raleway {
    font-family: 'Raleway', sans-serif;
  }

  .shimmer-text {
    background: linear-gradient(
      90deg, 
      #2f81f7 0%, 
      #a371f7 25%, 
      #3fb950 50%, 
      #a371f7 75%, 
      #2f81f7 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 4s linear infinite;
  }

  @keyframes shimmer {
    to {
      background-position: 200% center;
    }
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  :global(.is-visible) .reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>

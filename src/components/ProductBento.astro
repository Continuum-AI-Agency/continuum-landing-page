---
import { getImage } from 'astro:assets';
import { AnimatedBento } from './react/AnimatedBento';
import { BentoStudioCanvas } from './react/BentoStudioCanvas';
import { BentoSocialCalendar } from './react/BentoSocialCalendar';
import { BentoPerformanceChart } from './react/BentoPerformanceChart';
import { BentoPersonaCreative } from './react/BentoPersonaCreative';
import { BentoPersonaAgency } from './react/BentoPersonaAgency';
import Metrics from './Metrics.astro';

import imgRes1 from '../assets/Videos_templates/Resultado_1.jpg';
import imgRes2 from '../assets/Videos_templates/Resultado_2.jpg';
import imgRes3 from '../assets/Videos_templates/Resultado_3.jpg';
import continuumIcon from '../assets/Icons/Continuum-icon-2.jpg';

const [res1, res2, res3, logo] = await Promise.all([
  getImage({ src: imgRes1, width: 400, format: 'webp', quality: 70 }),
  getImage({ src: imgRes2, width: 400, format: 'webp', quality: 70 }),
  getImage({ src: imgRes3, width: 400, format: 'webp', quality: 70 }),
  getImage({ src: continuumIcon, width: 320, format: 'webp', quality: 70 }),
]);

const resultImages = [{ src: res1.src }, { src: res2.src }, { src: res3.src }];
---

<section id="product" class="pb-24 pt-0 bg-background relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mb-14 reveal">
      <h2 class="text-4xl md:text-6xl font-bold text-foreground mb-6 font-display tracking-tight">
        Signal in. <br/><span class="text-primary">Ads out.</span>
      </h2>
      <p class="text-xl text-muted-foreground font-sans leading-relaxed max-w-[38em]">
        A production line for ads that get better. Live account in, on-brand unit out,
        written back into spend so the next cycle already knows what happened.
      </p>
    </div>

    <!-- MAIN BENTO GRID -->
    <div class="flex flex-col gap-6 w-full max-w-[1400px] mx-auto reveal">
      
      <!-- MAIN ANIMATED BENTO (USE CLIENT) -->
      <div class="w-full mb-12">
        <AnimatedBento client:visible results={resultImages} logoSrc={logo.src} />
      </div>

      <!-- Bottom Row: 3 Interactive Modules -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
        
        {/* SOCIAL+ */}
        <div class="flex flex-col rounded-xl bg-card border border-border/40 shadow-[0_1px_3px_oklch(0%_0_0_/_40%),_inset_0_1px_0_oklch(100%_0_0_/_8%)] hover:border-primary/30 transition-all duration-500 group overflow-hidden h-[500px]">
          <div class="p-8 pb-4 flex-none">
             <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold mb-4 bg-brand-violet/10 text-brand-violet border border-brand-violet/25 tracking-wide font-mono">
               Social+
             </span>
             <h3 class="text-2xl font-bold text-foreground mb-2 tracking-tight font-sans">Always-on organic.</h3>
             <p class="text-muted-foreground text-sm font-sans leading-relaxed">
               Your design system becomes a publishing line. On-brand posts drafted, planned, and scheduled so your feeds never go quiet.
             </p>
          </div>
          <div class="flex-grow relative border-t border-border/30 mt-4 bg-background/30">
             <BentoSocialCalendar client:visible />
          </div>
        </div>

        {/* STUDIO+ */}
        <div class="flex flex-col rounded-xl bg-card border border-border/40 shadow-[0_1px_3px_oklch(0%_0_0_/_40%),_inset_0_1px_0_oklch(100%_0_0_/_8%)] hover:border-primary/30 transition-all duration-500 group overflow-hidden h-[500px]">
          <div class="p-8 pb-4 flex-none">
             <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold mb-4 bg-primary/10 text-primary border border-primary/20 tracking-wide font-mono">
               Studio+
             </span>
             <h3 class="text-2xl font-bold text-foreground mb-2 tracking-tight font-sans">Render automation at scale.</h3>
             <p class="text-muted-foreground text-sm font-sans leading-relaxed">
                Templates in, finished assets out. Our render fleet turns your design system into thousands of production-ready variations.
             </p>
          </div>
          <div class="flex-grow relative border-t border-border/30 mt-4">
             <BentoStudioCanvas client:visible />
          </div>
        </div>

        {/* PERFORMANCE+ */}
        <div class="flex flex-col rounded-xl bg-card border border-border/40 shadow-[0_1px_3px_oklch(0%_0_0_/_40%),_inset_0_1px_0_oklch(100%_0_0_/_8%)] hover:border-primary/30 transition-all duration-500 group overflow-hidden h-[500px]">
          <div class="p-8 pb-4 flex-none">
             <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold mb-4 bg-brand-magenta/10 text-brand-magenta border border-brand-magenta/25 tracking-wide font-mono">
               Performance+
             </span>
             <h3 class="text-2xl font-bold text-foreground mb-2 tracking-tight font-sans">DCO delivery.</h3>
             <p class="text-muted-foreground text-sm font-sans leading-relaxed">
                Finished creative ships straight into platform ad sets — via the <a href="https://developers.google.com/google-ads/api/docs/start" class="text-primary hover:underline font-medium">Google Ads API</a>, <a href="https://www.facebook.com/business/help/3856236611311910" class="text-primary hover:underline font-medium">Meta Advantage+</a>, and more — then swaps automatically as performance data lands.
             </p>
          </div>
          <div class="flex-grow relative border-t border-border/30 mt-4">
             <BentoPerformanceChart client:visible />
          </div>
        </div>

      </div>
    </div>

    <!-- METRICS -->
    <div class="mt-8 mb-4">
      <Metrics />
    </div>

    <!-- TARGET PERSONAS -->
    <div class="flex flex-col gap-6 reveal mt-10 max-w-[1400px] mx-auto">
      <BentoPersonaCreative client:visible />
      <BentoPersonaAgency client:visible />
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  :global(.is-visible) .reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>

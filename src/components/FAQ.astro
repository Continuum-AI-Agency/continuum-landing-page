---
---

<section id="faq" class="py-24 bg-background px-6 border-t border-border/30 relative z-10">
  <div class="max-w-4xl mx-auto mb-16 text-center reveal">
    <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-4 font-display uppercase">FAQ</h2>
    <p class="text-lg text-muted-foreground font-sans max-w-xl mx-auto">
      Quick answers to the most common questions about how Continuum works,
      how to integrate and how to subscribe.
    </p>
  </div>

  <div class="max-w-3xl mx-auto flex flex-col gap-4 font-sans">
    <!-- 1 -->
    <article class="ch-faq-item group rounded-xl bg-card border border-border/40 overflow-hidden shadow-sm transition-all duration-300 hover:border-primary/20 [&.is-open]:border-primary/30 [&.is-open]:bg-card/80 reveal">
      <button class="ch-faq-trigger w-full flex items-center justify-between p-6 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background" type="button">
        <span class="text-base font-semibold text-foreground transition-colors group-hover:text-primary">What exactly is Continuum?</span>
        <span class="text-xl text-muted-foreground font-mono transition-transform duration-300 group-[.is-open]:rotate-45 group-[.is-open]:text-primary" aria-hidden="true">+</span>
      </button>
      <div class="ch-faq-body">
        <p class="text-sm text-muted-foreground/90 leading-relaxed">
          Continuum is a <strong>creative OS</strong> that connects brief, data,
          templates and distribution in a single surface. It's not just a design
          tool or a dashboard: it's the place where <strong>brand, performance
          and agencies work on the same system</strong>.
        </p>
      </div>
    </article>

    <!-- 2 -->
    <article class="ch-faq-item group rounded-xl bg-card border border-border/40 overflow-hidden shadow-sm transition-all duration-300 hover:border-primary/20 [&.is-open]:border-primary/30 [&.is-open]:bg-card/80 reveal">
      <button class="ch-faq-trigger w-full flex items-center justify-between p-6 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background" type="button">
        <span class="text-base font-semibold text-foreground transition-colors group-hover:text-primary">
         Does it replace my agency or in-house team?
        </span>
        <span class="text-xl text-muted-foreground font-mono transition-transform duration-300 group-[.is-open]:rotate-45 group-[.is-open]:text-primary" aria-hidden="true">+</span>
      </button>
      <div class="ch-faq-body">
        <p class="text-sm text-muted-foreground/90 leading-relaxed">
          No. Continuum is designed to
          <strong>organize the creative system</strong> and make agencies,
          internal studios and performance teams work on the same foundation of
          <strong>templates, data and versions</strong>. This reduces friction and
          frees up time for ideas, not exports.
        </p>
      </div>
    </article>

    <!-- 3 -->
    <article class="ch-faq-item group rounded-xl bg-card border border-border/40 overflow-hidden shadow-sm transition-all duration-300 hover:border-primary/20 [&.is-open]:border-primary/30 [&.is-open]:bg-card/80 reveal">
      <button class="ch-faq-trigger w-full flex items-center justify-between p-6 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background" type="button">
        <span class="text-base font-semibold text-foreground transition-colors group-hover:text-primary">
          How does it integrate with the tools we already use?
        </span>
        <span class="text-xl text-muted-foreground font-mono transition-transform duration-300 group-[.is-open]:rotate-45 group-[.is-open]:text-primary" aria-hidden="true">+</span>
      </button>
      <div class="ch-faq-body">
        <p class="text-sm text-muted-foreground/90 leading-relaxed">
          Continuum connects with <strong>ads platforms</strong>, suites of
          <strong>analytics</strong> and tools of
          <strong>collaboration</strong> (Sheets, Asana, ClickUp, HubSpot, etc.).
          Performance data enters the system and returns as
          <strong>briefs, templates and prioritized tests</strong>.
        </p>
      </div>
    </article>

    <!-- 4 -->
    <article class="ch-faq-item group rounded-xl bg-card border border-border/40 overflow-hidden shadow-sm transition-all duration-300 hover:border-primary/20 [&.is-open]:border-primary/30 [&.is-open]:bg-card/80 reveal">
      <button class="ch-faq-trigger w-full flex items-center justify-between p-6 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background" type="button">
        <span class="text-base font-semibold text-foreground transition-colors group-hover:text-primary">How do the flights work and what are the prices?</span>
        <span class="text-xl text-muted-foreground font-mono transition-transform duration-300 group-[.is-open]:rotate-45 group-[.is-open]:text-primary" aria-hidden="true">+</span>
      </button>
      <div class="ch-faq-body">
        <p class="text-sm text-muted-foreground/90 leading-relaxed">
          The actual plans are defined by <strong>team size</strong>,
          <strong>production volume</strong> and <strong>modules</strong> you
          activate (Studio+, Social+, Performance+). The pricing table on the page
          is an example; in practice we work with
          <strong>custom plans based on usage</strong>.
        </p>
      </div>
    </article>

    <!-- 5 -->
    <article class="ch-faq-item group rounded-xl bg-card border border-border/40 overflow-hidden shadow-sm transition-all duration-300 hover:border-primary/20 [&.is-open]:border-primary/30 [&.is-open]:bg-card/80 reveal">
      <button class="ch-faq-trigger w-full flex items-center justify-between p-6 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background" type="button">
        <span class="text-base font-semibold text-foreground transition-colors group-hover:text-primary">
         What about security, data and compliance?
        </span>
        <span class="text-xl text-muted-foreground font-mono transition-transform duration-300 group-[.is-open]:rotate-45 group-[.is-open]:text-primary" aria-hidden="true">+</span>
      </button>
      <div class="ch-faq-body">
        <p class="text-sm text-muted-foreground/90 leading-relaxed">
          We work with <strong>default security best practices</strong>:
          role-based permissions, isolated environments and activity logs. Performance
          and creative data is used for your own account; it's not shared between
          clients or used to train public models with your information.
        </p>
      </div>
    </article>
  </div>
</section>

<style>
  .ch-faq-body {
    max-height: 0;
    opacity: 0;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, padding 0.3s ease;
    padding-inline: 1.5rem;
    padding-block: 0;
    overflow: hidden;
  }
  .ch-faq-item.is-open .ch-faq-body {
    max-height: 200px;
    opacity: 1;
    padding-block: 0 1.5rem;
  }
</style>

<script>
  // FAQ accordion
  const faqItems = document.querySelectorAll(".ch-faq-item");

  if (faqItems.length) {
    faqItems.forEach((item) => {
      const trigger = item.querySelector(".ch-faq-trigger");
      if (!trigger) return;

      trigger.addEventListener("click", () => {
        const isOpen = item.classList.contains("is-open");
        // cerramos todas
        faqItems.forEach((it) => it.classList.remove("is-open"));
        // si la que clickeamos no estaba abierta, la abrimos
        if (!isOpen) {
          item.classList.add("is-open");
        }
      });
    });
  }

  // Reveal
  if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
          entries.forEach(e => {
              if (e.isIntersecting) {
                  e.target.classList.add("is-visible");
                  observer.unobserve(e.target);
              }
          })
      }, { threshold: 0.1 });
      const el = document.querySelector("#faq");
      if(el) el.querySelectorAll(".reveal").forEach(r => observer.observe(r));
  }
</script>
---
import { getImage } from 'astro:assets';

// Every clip in src/assets/showcase, produced by `bun run optimize:media`.
const videos = import.meta.glob<{ default: string }>('../assets/showcase/*.mp4', { eager: true });
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/showcase/*.jpg', { eager: true });

// Display order and aria-labels. A clip shows only if it's listed here.
const CLIPS: [name: string, label: string][] = [
  ['privalia-hoco', 'Wireless earbuds sale for Privalia'],
  ['bembos-andes', 'Burger ad for Bembos, Andes'],
  ['kamay-coca-cola', 'Founding partner card, Kamay Code and Coca-Cola'],
  ['mcdonalds-arg-fra', "Argentina vs France stats for McDonald's"],
  ['caliente', 'Sign-up offer for Caliente'],
  ['privalia-calvin-klein', 'Calvin Klein Hot Sale for Privalia'],
  ['papa-johns', "Cyber sale for Papa John's"],
  ['tecate-cruz-azul', 'Cruz Azul stats card for Tecate'],
  ['dominos', "Pizza promo for Domino's"],
  ['heineken', 'Brand catalog'],
  ['vivo-day-pass', 'Gym day-pass offer'],
  ['mcdonalds-mccombo', "McCombo promo for McDonald's"],
  ['bembos-seaside', 'Burger ad for Bembos, seaside'],
  ['kamay', '3D rendering'],
  ['mercado-libre', 'Retail ads'],
  ['catalog-claro', 'E-commerce catalog'],
  ['consorcio', 'Real estate'],
  ['social', 'Social content'],
  ['influencer', 'Influencer content'],
];

const items = await Promise.all(
  CLIPS.map(async ([name, label]) => {
    const src = videos[`../assets/showcase/${name}.mp4`]?.default;
    const poster = posters[`../assets/showcase/${name}.jpg`]?.default;
    if (!src || !poster) throw new Error(`showcase: ${name}.mp4/.jpg missing, run bun run optimize:media`);
    const small = await getImage({ src: poster, width: 480, format: 'webp', quality: 65 });
    return { src, label, poster: small.src, w: poster.width, h: poster.height };
  }),
);

// Greedy masonry: each clip joins the shortest column (height in column widths). Columns 1-2 are
// the only ones on mobile and fill first. Speed is per column so tall and short ones move alike.
const SECONDS_PER_WIDTH = 13;
const visibility = ['flex', 'flex', 'hidden sm:flex', 'hidden md:flex', 'hidden lg:flex'];
const cols = visibility.map((v, i) => ({ items: [] as typeof items, units: 0, visibility: v, dir: i % 2 ? 'down' : 'up' }));
for (const item of items) {
  const col = cols.reduce((a, b) => (b.units < a.units ? b : a));
  col.items.push(item);
  col.units += item.h / item.w;
}
---

<section id="showcase" class="py-16 md:py-24 bg-transparent relative overflow-hidden z-10">
  <h2 class="sr-only">Made on Continuum: clips from live campaigns</h2>
  <div class="w-full max-w-none px-4 md:px-8 relative">
    <div
      id="showcase-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6 lg:gap-8 h-[80vh] min-h-[500px] max-h-[1000px] overflow-hidden relative"
    >
      {cols.map((col) => (
        <div class:list={['flex-col scroll-container', col.visibility]}>
          <div
            class:list={['flex flex-col gap-4 md:gap-6 lg:gap-8 pb-4 md:pb-6 lg:pb-8', `animate-scroll-${col.dir}`]}
            style={`--dur: ${Math.round(col.units * SECONDS_PER_WIDTH)}s`}
          >
            {[...col.items, ...col.items].map((item, i) => (
              <div
                aria-hidden={i >= col.items.length ? 'true' : undefined}
                class="w-full rounded-lg overflow-hidden bg-card border border-border/20 shadow-sm relative hover:border-primary/30 transition-colors duration-500"
                style={`aspect-ratio: ${item.w} / ${item.h}`}
              >
                <video
                  data-src={item.src}
                  poster={item.poster}
                  muted
                  playsinline
                  loop
                  preload="none"
                  disablepictureinpicture
                  disableremoteplayback
                  aria-label={item.label}
                  class="w-full h-full object-cover block lazy-video"
                ></video>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #showcase {
    content-visibility: auto;
    contain-intrinsic-size: auto 80vh;
  }

  /* Fade the columns into the starfield instead of cutting them off. */
  #showcase-grid {
    mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent);
  }

  .scroll-container {
    height: 100%;
    overflow: hidden;
  }

  @keyframes scroll-up {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  @keyframes scroll-down {
    0% { transform: translateY(-50%); }
    100% { transform: translateY(0); }
  }

  /* Each track is two copies of its column, padded by one gap, so -50% is exactly one copy. */
  .animate-scroll-up {
    animation: scroll-up var(--dur) linear infinite;
  }

  .animate-scroll-down {
    animation: scroll-down var(--dur) linear infinite;
  }


  @media (prefers-reduced-motion: reduce) {
    .animate-scroll-up,
    .animate-scroll-down {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  const MAX_PLAYING = 16; // every clip in view on a 5-column desktop plays
  const root = document.getElementById('showcase-grid');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const initLazyVideos = () => {
    if (!root || reduced) return;

    const playing = new Set<HTMLVideoElement>();
    const visible = new Set<HTMLVideoElement>();

    const attachSource = (video: HTMLVideoElement) => {
      const src = video.dataset.src;
      if (!src || video.getAttribute('src')) return;
      video.src = src;
      video.load();
    };

    const playIfRoom = (video: HTMLVideoElement) => {
      if (playing.has(video) || playing.size >= MAX_PLAYING) return;
      playing.add(video);
      const play = video.play();
      if (play !== undefined) {
        play.catch(() => playing.delete(video));
      }
    };

    const fillSlots = () => {
      for (const video of visible) {
        if (playing.size >= MAX_PLAYING) break;
        playIfRoom(video);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            visible.add(video);
            attachSource(video);
            playIfRoom(video);
          } else {
            visible.delete(video);
            video.pause();
            playing.delete(video);
          }
        }
        fillSlots();
      },
      { rootMargin: '80px 0px', threshold: 0.15 },
    );

    root.querySelectorAll('video.lazy-video').forEach((video) => observer.observe(video));
  };

  initLazyVideos();
</script>

---
import { Magnetic } from './core/magnetic';
import { ShimmerButton } from './ui/shimmer-button';
import { InteractiveGridPattern } from './react/InteractiveGridPattern';
---

<section id="demo" class="py-24 md:py-32 bg-transparent relative overflow-hidden">
  {/* Interactive Grid Pattern Background */}
  <div class="absolute inset-0 z-0">
    <InteractiveGridPattern 
      client:visible
      width={40}
      height={40}
      squares={[40, 20]}
      className="[mask-image:radial-gradient(500px_circle_at_center,white,transparent)] inset-x-0 inset-y-[-10%] h-[120%]"
    />
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto text-center reveal">
      <h2 class="text-h2 font-bold text-foreground mb-6 font-display text-balance">
        What will you make on <span class="shimmer pb-1">Continuum?</span>
      </h2>
      <p class="text-lead text-muted-foreground font-sans mb-12 max-w-[46ch] mx-auto">
        Tell us what you ship each week. We’ll show you the line that ships it.
      </p>
      
      <div class="flex flex-col items-center justify-center w-full">
        <form class="flex flex-col md:flex-row items-center justify-center gap-4 w-full max-w-2xl" id="footer-demo-form">
          <div class="w-full md:flex-1">
            <label for="footer-email" class="sr-only">Work email address</label>
            <input
              id="footer-email"
              type="email"
              name="email"
              autocomplete="email"
              spellcheck="false"
              placeholder="name@company.com"
              class="w-full bg-background border border-muted-foreground/50 rounded-sm px-6 py-4 text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background transition-all duration-150 h-[58px]"
              required
            />
          </div>
          <Magnetic client:visible>
            <ShimmerButton
              type="submit"
              shimmerColor="oklch(94% 0.08 195)"
              borderRadius="12px"
              background="linear-gradient(135deg, oklch(52% 0.13 205), oklch(42% 0.2 285))"
              className="btn-fill h-[58px] min-w-[200px] px-8 text-lg font-semibold [--btn-fill:oklch(40%_0.19_272)] shadow-[0_0_40px_-8px_oklch(80%_0.14_195/0.5)] hover:shadow-[0_0_64px_-4px_oklch(80%_0.14_195/0.75)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              Book a demo
            </ShimmerButton>
          </Magnetic>
        </form>
        <p class="mt-6 text-primary font-medium min-h-[1.5rem]" id="demo-success" role="status"></p>
      </div>
    </div>
  </div>
</section>


<script>
  const form = document.getElementById("footer-demo-form") as HTMLFormElement;
  const note = document.getElementById("demo-success");
  
  if (form && note) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector("input[type='email']") as HTMLInputElement;
      const email = input?.value || "";
      note.textContent = email ? `Got it. We’ll email ${email} to set a time.` : "Got it. We’ll be in touch to set a time.";
      form.reset();
      
      setTimeout(() => {
        note.textContent = "";
      }, 5000);
    });
  }
</script>

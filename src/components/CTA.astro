---
import { InteractiveHoverButton } from './ui/interactive-hover-button';
import { Magnetic } from './core/magnetic';
---

<section id="demo" class="py-24 bg-[#010409] border-t border-white/5">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center reveal">
      <h2 class="text-4xl md:text-6xl font-bold text-white mb-6 font-futura tracking-tight">
        Ready to scale on <span class="shimmer-text">Continuum?</span>
      </h2>
      <p class="text-xl text-gray-400 font-raleway mb-12 max-w-2xl mx-auto">
        Talk to our team and see how Continuum can become the creative engine
        behind your next stage of growth.
      </p>
      
      <div class="flex flex-col items-center justify-center w-full">
        <form class="flex flex-col md:flex-row items-center justify-center gap-4 w-full max-w-2xl" id="footer-demo-form">
          <div class="w-full md:flex-1">
            <input
              type="email"
              placeholder="Work email"
              class="w-full bg-white/5 border border-white/10 rounded-full px-8 py-4 text-white focus:outline-none focus:border-blue-500 transition-colors h-[58px]"
              required
            />
          </div>
          <Magnetic client:load>
            <InteractiveHoverButton client:load type="submit" className="whitespace-nowrap h-[58px] min-w-[200px]">
              Book a live demo
            </InteractiveHoverButton>
          </Magnetic>
        </form>
        <p class="mt-6 text-accent-blue font-medium min-h-[1.5rem]" id="demo-success"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .font-futura {
    font-family: 'Futura Maxi', sans-serif;
  }
  .font-raleway {
    font-family: 'Raleway', sans-serif;
  }
  .text-accent-blue { color: #2f81f7; }

  .shimmer-text {
    background: linear-gradient(
      90deg, 
      #2f81f7 0%, 
      #a371f7 25%, 
      #3fb950 50%, 
      #a371f7 75%, 
      #2f81f7 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 4s linear infinite;
  }

  @keyframes shimmer {
    to {
      background-position: 200% center;
    }
  }

  @keyframes highlight-pulse {
    0% { box-shadow: 0 0 0 0 rgba(47, 129, 247, 0.4); border-color: #2f81f7; }
    70% { box-shadow: 0 0 0 15px rgba(47, 129, 247, 0); border-color: #2f81f7; }
    100% { box-shadow: 0 0 0 0 rgba(47, 129, 247, 0); }
  }

  .highlight-pulse {
    animation: highlight-pulse 2s ease-out infinite;
    border-color: #2f81f7 !important;
  }
</style>

<script>
  const form = document.getElementById("footer-demo-form") as HTMLFormElement;
  const note = document.getElementById("demo-success");
  
  if (form && note) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector("input[type='email']") as HTMLInputElement;
      const email = input?.value || "";
      note.textContent = `Thanks${email ? `, ${email}` : ""}! We'll reach out shortly.`;
      form.reset();
      
      setTimeout(() => {
        note.textContent = "";
      }, 5000);
    });
  }
</script>

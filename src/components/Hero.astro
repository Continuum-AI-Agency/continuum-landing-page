---
import { Image } from 'astro:assets';
import { InteractiveHoverButton } from './ui/interactive-hover-button';
import { Magnetic } from './core/magnetic';
import { ProgressiveBlur } from './core/progressive-blur';
import { ScrollIndicator } from './react/ScrollIndicator';
import { HeroTypography } from './react/HeroTypography';
import logoImage from '../assets/Logo_Continuum.png';
import bgVideo from '../assets/Landing-Page.mp4';

// Icons
import iconGoogleAds from '../assets/Icons/icons8-google-ads.svg';
import iconTiktok from '../assets/Icons/icons8-tiktok.svg';
import iconMeta from '../assets/Icons/icons8-meta-96.png';
import iconYoutube from '../assets/Icons/icons8-youtube.svg';
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden bg-background z-0">
  <!-- Video Background with Crossfade -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none bg-background">
    <video 
      id="bg-video-1"
      src={bgVideo} 
      muted 
      playsinline 
      class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-40 scale-110 transition-opacity duration-1000"
    ></video>
    <video 
      id="bg-video-2"
      src={bgVideo} 
      muted 
      playsinline 
      class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-0 scale-110 transition-opacity duration-1000"
    ></video>
    <!-- Dark Overlay to ensure readability and seamless bottom transition -->
    <div class="absolute inset-0 bg-background/40"></div>
    <ProgressiveBlur 
      client:load
      className="absolute bottom-0 left-0 w-full h-64 z-10" 
      blurIntensity={1}
    />
  </div>

  <div class="container mx-auto px-6 relative z-20">
    <div class="max-w-5xl mx-auto flex flex-col items-center text-center">

      <div class="flex flex-col items-center mb-12 w-full">
        <div class="mb-12 logo-container opacity-0">
          <Image 
            src={logoImage} 
            alt="Continuum" 
            class="h-20 md:h-32 w-auto object-contain"
            loading="eager"
          />
        </div>
        
        <div className="mt-8 mb-12 flex flex-col items-center">
          <HeroTypography client:load />
          <p
            class="text-sm md:text-xl text-center max-w-3xl mx-auto text-muted-foreground mt-6 leading-relaxed font-sans hero-subtext opacity-0"
            style="animation: fadeUp 1s ease-out 1.2s forwards;"
          >
            <strong class="text-foreground font-semibold">Uplift 35% in conversion</strong>, <strong class="text-foreground font-semibold">save 90% of design efforts</strong>. Continuum is the infrastructure to operate your agency, connecting the digital world with real-time retail media data. Let AI listen, analyze, create, implement and optimize 360° — with data-driven design, create thousands of on-brand creatives and let every customer feel seen again.
          </p>
        </div>
      </div>

      <div class="flex flex-col items-center justify-center w-full cta-container opacity-0">
        <form class="flex flex-col md:flex-row items-center justify-center gap-4 w-full max-w-2xl" id="hero-demo-form">
          <div class="w-full md:flex-1">
            <label for="hero-email" class="sr-only">Work email address</label>
            <input
              id="hero-email"
              type="email"
              placeholder="Work email"
              class="w-full bg-background border border-muted-foreground/50 rounded-sm px-6 py-4 text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background transition-all duration-150 h-[58px]"
              required
            />
          </div>
          <Magnetic client:load>
            <button
              type="submit"
              class="whitespace-nowrap h-[58px] min-w-[200px] bg-primary text-primary-foreground font-medium rounded-md px-6 py-2 shadow-sm hover:bg-[oklch(75%_0.13_180)] transition-all duration-150 ease-standard focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background cursor-pointer"
            >
              Book a demo
            </button>
          </Magnetic>
        </form>
      </div>

      <!-- Trust Badge -->
      <div class="mt-20 flex flex-col items-center gap-6 trust-container opacity-0">
        <p class="text-[10px] uppercase tracking-[0.3em] text-muted-foreground/70 font-bold font-mono">Integrated with your marketing stack</p>
        <div class="flex flex-wrap items-center justify-center gap-10 opacity-80 hover:opacity-100 transition-all duration-500">
          <Image src={iconMeta} alt="Meta" class="h-8 w-auto object-contain" />
          <div class="relative group/soon">
            <Image src={iconTiktok} alt="TikTok" class="h-8 w-auto object-contain" />
            <span class="absolute -top-4 -right-8 px-2 py-0.5 rounded-full bg-muted/60 border border-border text-[8px] font-bold text-foreground whitespace-nowrap tracking-wider font-mono">SOON</span>
          </div>
          <Image src={iconGoogleAds} alt="Google Ads" class="h-8 w-auto object-contain" />
          <Image src={iconYoutube} alt="YouTube" class="h-8 w-auto object-contain" />
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <ScrollIndicator client:load />
</section>

<style>
  /* Professional solid white for the tagline */
  #hero-tagline :global(span) {
    display: inline-block;
    color: var(--foreground);
  }
</style>

<script>
  import { animate, stagger } from "motion";

  // 1. Seamless Crossfade Video Logic
  const v1 = document.getElementById('bg-video-1') as HTMLVideoElement;
  const v2 = document.getElementById('bg-video-2') as HTMLVideoElement;
  
  if (v1 && v2) {
    let activeVideo = v1;
    let nextVideo = v2;
    const fadeTime = 1.5;

    const handleCrossfade = () => {
      if (activeVideo.currentTime > activeVideo.duration - fadeTime) {
        if (nextVideo.paused) {
          nextVideo.currentTime = 0;
          nextVideo.play();
          nextVideo.classList.replace('opacity-0', 'opacity-40');
          activeVideo.classList.replace('opacity-40', 'opacity-0');
          [activeVideo, nextVideo] = [nextVideo, activeVideo];
        }
      }
    };

    v1.addEventListener('timeupdate', handleCrossfade);
    v2.addEventListener('timeupdate', handleCrossfade);
    v1.playbackRate = 0.8;
    v2.playbackRate = 0.8;
    v1.play();
  }

  // 2. Motion Animations
  const tagline = document.getElementById('hero-tagline');
  if (tagline) {
    const text = tagline.textContent?.trim() || "";
    tagline.innerHTML = text.split('').map(char => 
      `<span class="whitespace-pre">${char}</span>`
    ).join('');
    
    const chars = tagline.querySelectorAll('span');
    const splitIndex = text.indexOf("Scale");

    if (splitIndex !== -1) {
      const firstPart = Array.from(chars).slice(0, splitIndex);
      const secondPart = Array.from(chars).slice(splitIndex);

      animate(
        firstPart, 
        { 
          filter: ["blur(10px)", "blur(0px)"], 
          opacity: [0, 1], 
          y: [20, 0] 
        }, 
        { 
          delay: stagger(0.02, { startDelay: 0.3 }), 
          duration: 0.8, 
          easing: [0.16, 1, 0.3, 1] 
        }
      );

      animate(
        secondPart, 
        { 
          filter: ["blur(10px)", "blur(0px)"], 
          opacity: [0, 1], 
          y: [20, 0] 
        }, 
        { 
          delay: stagger(0.02, { startDelay: 1.25 }), 
          duration: 0.8, 
          easing: [0.16, 1, 0.3, 1] 
        }
      );
    } else {
      animate(
        chars, 
        { 
          filter: ["blur(10px)", "blur(0px)"], 
          opacity: [0, 1], 
          y: [20, 0] 
        }, 
        { 
          delay: stagger(0.02, { startDelay: 0.3 }), 
          duration: 0.8, 
          easing: [0.16, 1, 0.3, 1] 
        }
      );
    }
  }

  // Animate other containers
  animate(".logo-container", { opacity: [0, 1], y: [20, 0] }, { duration: 1, easing: [0.16, 1, 0.3, 1] });
  animate(".cta-container", { opacity: [0, 1], y: [20, 0] }, { delay: 2, duration: 1, easing: [0.16, 1, 0.3, 1] });
  animate(".trust-container", { opacity: [0, 1] }, { delay: 2.2, duration: 1 });
</script>

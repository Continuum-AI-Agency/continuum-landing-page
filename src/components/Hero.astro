---
import { HeroStage } from './react/HeroStage';
import LogoCloud from './LogoCloud.astro';
---

<section class="dark hero-section relative z-0 min-h-[100dvh] overflow-hidden bg-[#0b0b0e]">
  <nav class="absolute top-0 left-0 right-0 z-40 flex items-center justify-center md:justify-end gap-5 md:gap-9 px-6 md:px-12 py-5 font-sans">
    <a href="/technology/" class="text-sm tracking-wide font-medium text-white/70 hover:text-white transition-colors">Technology</a>
    <a href="/social-plus" class="text-sm tracking-wide font-medium text-white/70 hover:text-white transition-colors">Social+</a>
    <a href="/blog/" class="text-sm tracking-wide font-medium text-white/70 hover:text-white transition-colors">Blog</a>
    <a href="/press/" class="text-sm tracking-wide font-medium text-white/70 hover:text-white transition-colors">Press</a>
    <a href="/podcasts/" class="text-sm tracking-wide font-medium text-white/70 hover:text-white transition-colors">Podcasts</a>
  </nav>

  <HeroStage client:load />

  <div id="proof" class="absolute inset-x-0 bottom-6 md:bottom-8 z-20 px-6">
    <LogoCloud label={false} tone="on-dark" duration={38} class="w-full max-w-5xl mx-auto" />
  </div>
</section>

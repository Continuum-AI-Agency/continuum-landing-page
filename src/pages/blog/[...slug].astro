---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { PortableText } from 'emdash/ui';
import type { ImageValue } from 'emdash';
import {
  formatPostDate,
  getPost,
  jsonLd,
  listAllPosts,
  readingTimeMinutes,
  type Post,
} from '../../lib/posts';

const SITE = 'https://trycontinuum.ai';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const slug = Astro.params.slug;
if (!slug) return Astro.rewrite('/404');

let post: Post | null;
try {
  post = await getPost(slug);
} catch (error) {
  console.error(`[blog] Failed to load post "${slug}":`, error);
  return new Response('Unable to load blog post', { status: 500 });
}
if (!post) return Astro.rewrite('/404');

let relatedPosts: Post[];
try {
  const otherPosts = (await listAllPosts()).filter((candidate) => candidate.slug !== post!.slug);
  relatedPosts = [
    ...otherPosts.filter((candidate) => candidate.category === post!.category),
    ...otherPosts.filter((candidate) => candidate.category !== post!.category),
  ].slice(0, 3);
} catch (error) {
  console.error(`[blog] Failed to load related posts for "${slug}":`, error);
  return new Response('Unable to load related posts', { status: 500 });
}

const canonicalURL = new URL(`/blog/${post.slug}/`, SITE);
const title = post.metaTitle ?? `${post.title} | Continuum`;
const description = post.metaDescription ?? post.description ?? post.excerpt;
const publishedAt = post.pubDate;
const updatedAt = post.updatedDate ?? publishedAt;
async function coverImageUrl(value: ImageValue | null | undefined): Promise<string | undefined> {
  if (!value) return undefined;

  const internalPrefix = '/_emdash/api/media/file/';
  const resolveLocalKey = (key: string) => Astro.locals.emdash?.getPublicMediaUrl?.(key) || `${internalPrefix}${encodeURIComponent(key)}`;

  if (value.src) {
    if (value.src.startsWith(internalPrefix)) {
      const encodedKey = value.src.slice(internalPrefix.length);
      let key = encodedKey;
      try {
        key = decodeURIComponent(encodedKey);
      } catch {
        // Preserve the original path when legacy media contains an invalid escape.
      }
      return resolveLocalKey(key);
    }
    return value.src;
  }

  const storageKey = value.meta?.storageKey;
  if (typeof storageKey === 'string' && storageKey) return resolveLocalKey(storageKey);

  if ((value.provider ?? 'local') === 'local') {
    return value.id ? `${internalPrefix}${encodeURIComponent(value.id)}` : undefined;
  }

  const provider = Astro.locals.emdash?.getMediaProvider(value.provider ?? '');
  if (!provider) return undefined;
  try {
    const embed = await provider.getEmbed(value, { width: 1200 });
    return embed.type === 'image' ? embed.src : undefined;
  } catch (error) {
    console.warn(`[blog] Failed to resolve cover image for "${slug}":`, error);
    return undefined;
  }
}

const image = (await coverImageUrl(post.coverImage)) ?? `${SITE}/og.jpg`;
const readingTime = readingTimeMinutes(post.content);

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  author: {
    '@type': 'Person',
    name: post.author,
    ...(post.authorTitle ? { jobTitle: post.authorTitle } : {}),
    worksFor: { '@type': 'Organization', name: 'Continuum', url: SITE },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Continuum',
    logo: { '@type': 'ImageObject', url: `${SITE}/logo-mark.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
  image,
  articleSection: post.category,
};

const faqSchema = post.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.faq.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonicalURL.toString() },
  ],
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL} ogType="article" image={image}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(articleSchema)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={jsonLd(faqSchema)} />}
  <script type="application/ld+json" slot="head" set:html={jsonLd(breadcrumbSchema)} />

  <div class="relative min-h-screen bg-background text-foreground font-sans selection:bg-primary/20 selection:text-primary">
    <nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 border-b border-border/10 bg-background/80 backdrop-blur-md">
      <a href="/blog/" class="group flex items-center gap-2 font-display text-[10px] tracking-wide text-foreground hover:text-primary transition-colors">
        <span class="text-muted-foreground/40 group-hover:text-primary group-hover:-translate-x-0.5 transition-all">←</span>
        Blog
      </a>
      <a href="/" class="font-display text-[10px] tracking-wide text-muted-foreground hover:text-primary transition-colors">
        Continuum
      </a>
    </nav>

    <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
      <nav aria-label="Breadcrumb" class="mb-8 text-[11px] tracking-wide font-mono text-muted-foreground/60">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-primary transition-colors">Blog</a>
      </nav>

      <header class="mb-12">
        <div class="flex flex-wrap items-center gap-3 text-[10px] tracking-wide font-mono mb-6">
          <span class="text-primary font-bold">{post.category}</span>
          <span class="text-muted-foreground/40">•</span>
          <time datetime={publishedAt.toISOString()} class="text-muted-foreground/70">{formatPostDate(publishedAt)}</time>
          <span class="text-muted-foreground/40">•</span>
          <span class="text-muted-foreground/70">{readingTime} min read</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold font-display text-foreground leading-[1.1] tracking-tight">
          {post.title}
        </h1>
        <p class="mt-6 text-sm text-muted-foreground">
          By <span class="text-foreground font-medium">{post.author}</span>
          {post.authorTitle ? `, ${post.authorTitle} of Continuum` : ' of Continuum'}
        </p>
      </header>

      <div class="prose-blog">
        <PortableText value={post.content ?? []} />
      </div>

      {post.press && post.sourcePublication && (
        <aside class="mt-12 rounded-xl border border-border/40 bg-card/30 p-6 flex flex-col gap-1">
          <span class="text-[10px] tracking-wide font-mono text-primary font-bold">Originally featured in</span>
          <p class="text-base text-foreground font-medium mt-1">
            {post.sourceUrl ? (
              <a href={post.sourceUrl} target="_blank" rel="noopener" class="hover:text-primary transition-colors underline-offset-4 hover:underline">
                {post.sourcePublication}
              </a>
            ) : post.sourcePublication}
          </p>
          <p class="text-sm text-muted-foreground">
            {post.sourceAuthor && <span>By {post.sourceAuthor}</span>}
            {post.sourceAuthor && post.sourceDate && <span> · </span>}
            {post.sourceDate && <span>{formatPostDate(post.sourceDate)}</span>}
          </p>
        </aside>
      )}

      {relatedPosts.length > 0 && (
        <section aria-labelledby="related-posts-title" class="mt-16">
          <h2 id="related-posts-title" class="text-xl font-semibold font-display text-foreground">Keep reading</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {relatedPosts.map((related) => (
              <a href={`/blog/${related.slug}/`} class="group rounded-xl border border-border/40 bg-card/30 p-5 hover:bg-card/60 transition-colors">
                <span class="text-[10px] tracking-wide font-mono text-primary font-bold">{related.category}</span>
                <h3 class="mt-3 text-base font-semibold font-display leading-snug group-hover:text-primary transition-colors">{related.title}</h3>
                <p class="mt-2 text-xs text-muted-foreground">{formatPostDate(related.pubDate)}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="mt-16 rounded-xl border border-border/40 bg-card/40 p-8 md:p-10 text-center">
        <h2 class="text-xl md:text-2xl font-semibold font-display text-foreground">
          See your brand, personalized at scale
        </h2>
        <p class="mt-3 text-sm md:text-base text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Continuum is the structured creative layer that renders hundreds of on-brand,
          on-spec variations automatically. Book a demo and we'll show you your own creative, live.
        </p>
        <a
          href="/"
          class="mt-6 inline-flex items-center justify-center h-[52px] min-w-[200px] bg-primary text-primary-foreground font-medium rounded-md px-6 shadow-sm hover:bg-[oklch(75%_0.13_180)] transition-all"
        >
          Book a demo
        </a>
      </div>

      <div class="mt-12 text-center">
        <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-primary transition-colors">
          <span>←</span> Back to all articles
        </a>
      </div>
    </article>
  </div>

  <Footer />
</Layout>

<style is:global>
  .prose-blog {
    color: color-mix(in oklab, var(--foreground) 84%, transparent);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .prose-blog > * + * { margin-top: 1.3rem; }
  .prose-blog > p:first-child {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--foreground);
  }
  .prose-blog h2 {
    font-family: var(--font-display);
    color: var(--foreground);
    font-weight: 700;
    font-size: 1.7rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 3.25rem;
    margin-bottom: 0.5rem;
  }
  .prose-blog h3 {
    font-family: var(--font-display);
    color: var(--foreground);
    font-weight: 600;
    font-size: 1.3rem;
    margin-top: 2.25rem;
    margin-bottom: 0.25rem;
  }
  .prose-blog strong { color: var(--foreground); font-weight: 600; }
  .prose-blog em { font-style: italic; }
  .prose-blog a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    text-underline-offset: 3px;
  }
  .prose-blog a:hover { text-decoration: underline; }
  .prose-blog ul, .prose-blog ol { padding-left: 1.4rem; }
  .prose-blog ul { list-style: disc; }
  .prose-blog ol { list-style: decimal; }
  .prose-blog li { margin-top: 0.55rem; padding-left: 0.35rem; }
  .prose-blog li::marker { color: var(--primary); }
  .prose-blog blockquote {
    border-left: 2px solid var(--primary);
    padding-left: 1.25rem;
    color: var(--muted-foreground);
    font-style: italic;
  }
  .prose-blog code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--card);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose-blog img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    margin: 2rem auto;
  }
  .prose-blog video { max-width: 100%; border-radius: 12px; }
  .prose-blog iframe { max-width: 100%; border: 0; border-radius: 12px; }
  .prose-blog hr { border: 0; border-top: 1px solid color-mix(in oklab, var(--border) 50%, transparent); }
  .prose-blog table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .prose-blog th, .prose-blog td { padding: 0.7rem 0.85rem; border: 1px solid color-mix(in oklab, var(--border) 50%, transparent); text-align: left; }
  .prose-blog thead th { color: var(--foreground); font-weight: 600; background: var(--card); }
  .prose-blog tbody td:first-child { color: var(--foreground); font-weight: 500; }
</style>

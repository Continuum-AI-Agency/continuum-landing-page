---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import {
  formatPostDate,
  jsonLd,
  listPostsPage,
  readingTimeMinutes,
} from '../../lib/posts';

const SITE = 'https://trycontinuum.ai';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let pageResult;
try {
  pageResult = await listPostsPage(page);
} catch (error) {
  console.error('[blog] Failed to load published posts:', error);
  return new Response('Unable to load blog posts', { status: 500 });
}

if (page > 1 && pageResult.posts.length === 0) return Astro.rewrite('/404');

const { posts, hasPrevious, hasNext } = pageResult;
const canonicalURL = new URL(page === 1 ? '/blog/' : `/blog/?page=${page}`, SITE);
const title = 'Creative Automation & Performance Marketing Blog | Continuum';
const description =
  'Guides on AI-native DCO, on-brand creative at scale, stock-aware dynamic ads, and ad personalization, from the team building Continuum.';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Continuum Blog',
  description,
  url: canonicalURL.toString(),
  publisher: {
    '@type': 'Organization',
    name: 'Continuum',
    logo: { '@type': 'ImageObject', url: `${SITE}/logo-mark.png` },
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.pubDate.toISOString(),
    dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
    url: `${SITE}/blog/${post.slug}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
  ],
};

const pageHref = (target: number) => (target === 1 ? '/blog/' : `/blog/?page=${target}`);
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(blogSchema)} />
  <script type="application/ld+json" slot="head" set:html={jsonLd(breadcrumbSchema)} />

  <div class="relative min-h-screen bg-background text-foreground font-sans selection:bg-primary/20 selection:text-primary">
    <nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 border-b border-border/10 bg-background/80 backdrop-blur-md">
      <a href="/" class="group flex items-center gap-2 font-display text-[10px] tracking-wide text-foreground hover:text-primary transition-colors">
        <span class="text-muted-foreground/40 group-hover:text-primary group-hover:-translate-x-0.5 transition-all">←</span>
        Continuum
      </a>
      <span class="font-sans text-[9px] font-bold tracking-wide text-muted-foreground border border-border/20 px-3 py-1 rounded-full bg-card/40">
        Blog
      </span>
    </nav>

    <main class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <header class="mb-16 max-w-3xl">
        <p class="text-[10px] tracking-wide text-primary font-bold font-mono mb-5">Insights</p>
        <h1 class="text-4xl md:text-6xl font-bold font-display tracking-tight leading-none text-foreground">
          The Continuum Blog
        </h1>
        <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed">
          Field notes on producing on-brand creative at scale, stock-aware dynamic advertising,
          and the personalization layer that makes every customer feel seen.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-px bg-border/30 rounded-xl overflow-hidden border border-border/30">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group block bg-background hover:bg-card/40 transition-colors duration-300 p-8 md:p-10"
          >
            <article class="flex flex-col gap-4">
              <div class="flex items-center gap-3 text-[10px] tracking-wide font-mono">
                <span class="text-primary font-bold">{post.category}</span>
                <span class="text-muted-foreground/40">•</span>
                <span class="text-muted-foreground/70">{formatPostDate(post.pubDate)}</span>
                <span class="text-muted-foreground/40">•</span>
                <span class="text-muted-foreground/70">{readingTimeMinutes(post.content)} min read</span>
              </div>
              <h2 class="text-2xl md:text-3xl font-semibold font-display text-foreground leading-tight group-hover:text-primary transition-colors">
                {post.title}
              </h2>
              <p class="text-sm md:text-base text-muted-foreground leading-relaxed max-w-3xl">
                {post.excerpt}
              </p>
              <span class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-primary">
                Read article <span class="group-hover:translate-x-1 transition-transform">→</span>
              </span>
            </article>
          </a>
        ))}
      </div>

      {(hasPrevious || hasNext) && (
        <nav aria-label="Blog pages" class="mt-8 flex items-center justify-between text-sm">
          {hasPrevious ? (
            <a href={pageHref(page - 1)} class="text-primary hover:underline">← Newer posts</a>
          ) : <span />}
          <span class="text-muted-foreground">Page {page}</span>
          {hasNext ? (
            <a href={pageHref(page + 1)} class="text-primary hover:underline">Older posts →</a>
          ) : <span />}
        </nav>
      )}
    </main>
  </div>

  <Footer />
</Layout>

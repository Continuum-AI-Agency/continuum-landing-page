---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MasonryGrid from '../components/MasonryGrid.astro';
import Product from '../components/Product.astro';
import FounderStrip from '../components/FounderStrip.astro';
import Proof from '../components/Proof.astro';
import Pricing from '../components/Pricing.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import Sky from '../components/Sky.astro';
import SiteNav from '../components/SiteNav.astro';
---

<Layout appearance="light">
  <Sky />
  <SiteNav />
  <Hero />
  <div class="dark">
    <MasonryGrid />
  </div>
  <div class="horizon horizon-dawn" aria-hidden="true"></div>
  <div class="daylight">
    <Product />
    <Proof />
    <FounderStrip />
    <Pricing />
  </div>
  <div class="horizon horizon-dusk" aria-hidden="true"></div>
  <div class="dark">
    <CTA />
    <Footer />
  </div>
</Layout>

<script>
  import { animate, inView, stagger } from "motion";

  // Animate elements with the .reveal class as they come into view
  inView(
    ".reveal",
    (element) => {
      animate(
        element,
        { opacity: [0, 1], y: [40, 0] },
        { 
          duration: 0.8, 
          easing: [0.16, 1, 0.3, 1] // Custom cubic-bezier for a premium feel
        }
      );

      // If the revealed section contains grid items or cards, stagger them
      const items = element.querySelectorAll(".group, .grid > div");
      if (items.length > 0) {
        animate(
          items,
          { opacity: [0, 1], scale: [0.95, 1], y: [20, 0] },
          { 
            delay: stagger(0.1, { startDelay: 0.2 }),
            duration: 0.5
          }
        );
      }
    },
    { amount: 0.15 }
  );
</script>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MasonryGrid from '../components/MasonryGrid.astro';
import Logos from '../components/Logos.astro';
import ProductBento from '../components/ProductBento.astro';
import Team from '../components/Team.astro';
import { PricingSection } from '../components/react/Pricing';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Hero />
  <MasonryGrid />
  <Logos />
  <ProductBento />
  <Team />
  <PricingSection />
  <CTA />

  <Footer />
</Layout>

<script>
  import { animate, inView, stagger } from "motion";

  // Animate elements with the .reveal class as they come into view
  inView(
    ".reveal",
    (element) => {
      animate(
        element,
        { opacity: [0, 1], y: [40, 0] },
        { 
          duration: 0.8, 
          easing: [0.16, 1, 0.3, 1] // Custom cubic-bezier for a premium feel
        }
      );

      // If the revealed section contains grid items or cards, stagger them
      const items = element.querySelectorAll(".group, .grid > div");
      if (items.length > 0) {
        animate(
          items,
          { opacity: [0, 1], scale: [0.95, 1], y: [20, 0] },
          { 
            delay: stagger(0.1, { startDelay: 0.2 }),
            duration: 0.5
          }
        );
      }
    },
    { amount: 0.15 }
  );
</script>

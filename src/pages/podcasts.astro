---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const SITE = 'https://trycontinuum.ai';

interface Talk {
  title: string;
  series: string;
  description: string;
  speaker?: string;
  youtubeId: string;
  start?: number; // start time in seconds
  language?: string;
}

const talks: Talk[] = [
  {
    title: 'Los Mitos de la IA',
    series: 'Podcast',
    description:
      'Michelle Shocron desarma los mitos más comunes sobre la inteligencia artificial — qué puede y qué no puede hacer hoy, y qué significa realmente para los negocios y el marketing.',
    speaker: 'Michelle Shocron',
    youtubeId: 'vkr4tf0Rt64',
    start: 16,
    language: 'Spanish',
  },
];

const watchUrl = (t: Talk) =>
  `https://www.youtube.com/watch?v=${t.youtubeId}${t.start ? `&t=${t.start}s` : ''}`;
const thumbUrl = (t: Talk) => `https://img.youtube.com/vi/${t.youtubeId}/maxresdefault.jpg`;

const title = 'Podcasts & Market Talks — Michelle Shocron | Continuum';
const description =
  'Watch Continuum founder Michelle Shocron on podcasts and market talks — the myths and realities of AI, building in artificial intelligence, and where marketing is going.';

// VideoObject structured data (SEO / AEO)
const videoSchemas = talks.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: t.title,
  description: t.description,
  thumbnailUrl: [thumbUrl(t)],
  embedUrl: `https://www.youtube.com/embed/${t.youtubeId}`,
  contentUrl: watchUrl(t),
  ...(t.language ? { inLanguage: t.language } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Continuum',
    logo: { '@type': 'ImageObject', url: `${SITE}/assets/Logo_Continuum (1).png` },
  },
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Podcasts', item: `${SITE}/podcasts/` },
  ],
};
---

<Layout title={title} description={description}>
  {videoSchemas.map((s) => (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(s)} />
  ))}
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="relative min-h-screen bg-background text-foreground font-sans selection:bg-primary/20 selection:text-primary">
    <!-- Nav -->
    <nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 border-b border-border/10 bg-background/80 backdrop-blur-md">
      <a href="/" class="group flex items-center gap-2 font-display text-[10px] tracking-wide text-foreground hover:text-primary transition-colors">
        <span class="text-muted-foreground/40 group-hover:text-primary group-hover:-translate-x-0.5 transition-all">←</span>
        Continuum
      </a>
      <span class="font-sans text-[9px] font-bold tracking-wide text-muted-foreground border border-border/20 px-3 py-1 rounded-full bg-card/40">
        Podcasts
      </span>
    </nav>

    <main class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <!-- Header -->
      <header class="mb-16 max-w-3xl">
        <p class="text-[10px] tracking-wide text-primary font-bold font-mono mb-5">Podcasts &amp; Talks</p>
        <h1 class="text-4xl md:text-6xl font-bold font-display tracking-tight leading-none text-foreground">
          Podcasts &amp; Market Talks
        </h1>
        <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed">
          Continuum founder <span class="text-foreground font-medium">Michelle Shocron</span> on podcasts
          and industry stages — the myths and realities of AI, building in artificial intelligence, and
          where marketing is going.
        </p>
      </header>

      <!-- Talks grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          talks.map((t) => (
            <a
              href={watchUrl(t)}
              target="_blank"
              rel="noopener"
              class="group block rounded-xl overflow-hidden border border-border/30 bg-card/30 hover:bg-card/50 transition-colors"
            >
              <div class="relative aspect-video overflow-hidden bg-muted">
                <img
                  src={thumbUrl(t)}
                  onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${t.youtubeId}/hqdefault.jpg'`}
                  alt={`${t.title} — watch on YouTube`}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                {/* Play overlay */}
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-black/55 backdrop-blur-sm border border-white/20 transition-all duration-300 group-hover:bg-primary group-hover:scale-110">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-white translate-x-0.5" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
                {t.language && (
                  <span class="absolute top-3 left-3 rounded-full bg-black/60 backdrop-blur-sm px-2.5 py-0.5 text-[10px] font-bold tracking-wide text-white/90 font-mono border border-white/15">
                    {t.language}
                  </span>
                )}
              </div>

              <div class="p-6">
                <div class="flex items-center gap-3 text-[10px] tracking-wide font-mono mb-3">
                  <span class="text-primary font-bold">{t.series}</span>
                  {t.speaker && (
                    <>
                      <span class="text-muted-foreground/40">•</span>
                      <span class="text-muted-foreground/70">{t.speaker}</span>
                    </>
                  )}
                </div>
                <h2 class="text-xl md:text-2xl font-semibold font-display text-foreground leading-tight group-hover:text-primary transition-colors">
                  {t.title}
                </h2>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{t.description}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary">
                  Watch on YouTube <span>↗</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </main>
  </div>

  <Footer />
</Layout>

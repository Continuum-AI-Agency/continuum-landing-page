---
import Layout from '../layouts/Layout.astro';
import Sky from '../components/Sky.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { ShimmerButton } from '../components/ui/shimmer-button';

const MCP_URL = 'https://api.trycontinuum.ai/mcp/v2';
const CLAUDE_CODE_CMD = 'claude mcp add --transport http social-plus https://api.trycontinuum.ai/mcp/v2';

const capabilities = [
  { name: 'Trend detection', body: 'Surface trends and opportunities from social listening, keywords, and external signals — segmented by country, city, and category.' },
  { name: 'Brand-aligned generation', body: 'Generate images and video on canvas workflows in 1:1, 9:16, and 16:9, grounded in your brand guidelines.' },
  { name: 'Editorial planning', body: 'Turn signals into a weekly publishing schedule for Instagram and LinkedIn, from draft to ready to published.' },
  { name: 'Paid media copilot', body: 'Jaina reads campaign performance, flags winners, and drafts the next action set for approval.' },
];

const prompts = [
  { title: 'Find my opening', body: '“Check Signal Radar for fintech trends in Mexico City this week and rank the top 3 opportunities for our brand.”' },
  { title: 'Make the asset', body: '“Take opportunity #1 and generate a 5-set Visual Lab canvas in 9:16 and 1:1, on brand.”' },
  { title: 'Plan the week', body: '“Turn this week’s signals into a Mon–Fri editorial calendar for Instagram and LinkedIn.”' },
  { title: 'Spend smarter', body: '“Ask Jaina to review last week’s Meta spend and draft the next budget move.”' },
];

const hosts = [
  {
    name: 'Claude Code',
    tag: 'Terminal · recommended',
    steps: ['Run the command below in your terminal.', 'Restart Claude Code so it picks up the new server.', 'Type /mcp to confirm social-plus is listed.'],
  },
  {
    name: 'Claude Desktop',
    tag: 'Custom connector',
    steps: ['Open Settings → Connectors (or Developer) → Add custom connector.', 'Paste the server URL below and complete setup.', 'Restart Claude Desktop and approve the connector.'],
  },
  {
    name: 'Any MCP client',
    tag: 'Streamable HTTP',
    steps: ['Add a new MCP server with the endpoint URL.', 'Add the credentials your Continuum workspace issued, if asked.', 'Save, reconnect, and list tools to verify.'],
  },
];
---

<Layout
  title="Social+ for Claude — MCP Connector Guide · Continuum"
  description="Connect Social+ to Claude via MCP: install the connector in Claude Code or Claude Desktop, browse the tools, and run trend-to-post workflows with copy-paste prompts."
  appearance="light"
>
  <Sky />
  <SiteNav />

  <!-- Night hero -->
  <section class="relative overflow-hidden bg-[var(--night)] pb-20 pt-32 text-white md:pb-28 md:pt-40">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <p class="font-display text-base font-semibold text-brand-violet">Continuum / Social+ for Claude</p>
      <h1 class="mt-2 max-w-4xl text-balance font-display text-h2 font-bold">
        Social+ for Claude: the <span class="shimmer">MCP connector</span> guide.
      </h1>
      <p class="mt-5 max-w-[46ch] text-lead text-white/70">
        Install once. Then detect trends, generate brand-aligned creative, and
        plan your week — all inside Claude. Powered by our
        <a href="/technology" class="font-semibold text-white underline underline-offset-4 hover:text-white/80"> design automation engine</a>.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <ShimmerButton
          href="#connect"
          shimmerColor="oklch(94% 0.08 195)"
          borderRadius="12px"
          background="linear-gradient(135deg, oklch(52% 0.13 205), oklch(42% 0.2 285))"
          className="btn-fill h-14 px-9 text-lg font-semibold [--btn-fill:oklch(40%_0.19_272)] shadow-[0_0_48px_-8px_oklch(80%_0.14_195/0.55)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          Connect in minutes
        </ShimmerButton>
        <div class="flex items-center gap-2 font-mono text-[13px]">
          <code class="truncate rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3 text-white/85">{MCP_URL}</code>
          <button class="copy-btn rounded-lg border border-white/10 bg-white/[0.04] px-3 py-3 text-white/70 transition-colors hover:text-white" data-copy={MCP_URL} title="Copy MCP URL" aria-label="Copy MCP URL">⧉</button>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-2 text-xs">
        <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-white/70">Claude Code</span>
        <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-white/70">Claude Desktop</span>
        <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-white/70">Any MCP client</span>
      </div>
    </div>
  </section>

  <div class="horizon horizon-dawn" aria-hidden="true"></div>

  <!-- Daylight guide -->
  <div class="bg-[linear-gradient(var(--day-top),var(--day-low))] text-foreground">
    <div class="mx-auto max-w-7xl px-4 py-24 md:px-6 md:py-32">

      <!-- 01 Connect -->
      <section id="connect" class="scroll-mt-24" aria-labelledby="connect-title">
        <p class="font-display text-base font-semibold text-brand-violet">01 · Install</p>
        <h2 id="connect-title" class="mt-1 max-w-3xl text-balance font-display text-h2 font-bold">Connect in minutes.</h2>
        <p class="mt-4 max-w-[46ch] text-lead text-muted-foreground">
          Social+ isn't listed in a public connector registry — add it manually
          with the server URL. Pick your host below.
        </p>

        <div class="mt-10 grid gap-4 lg:grid-cols-3">
          {hosts.map((h) => (
            <div class="flex flex-col rounded-xl border border-border bg-background p-6">
              <p class="font-display text-xl font-bold">{h.name}</p>
              <p class="mt-1 font-mono text-xs text-brand-violet">{h.tag}</p>
              <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-muted-foreground">
                {h.steps.map((s) => <li>{s}</li>)}
              </ol>
            </div>
          ))}
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class="overflow-hidden rounded-xl border border-border bg-background">
            <div class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-3">
              <p class="font-mono text-xs font-semibold text-muted-foreground">Claude Code · terminal</p>
              <button class="copy-btn font-mono text-xs text-brand-violet hover:underline" data-copy={CLAUDE_CODE_CMD} title="Copy command">Copy</button>
            </div>
            <pre class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-relaxed"><code>{CLAUDE_CODE_CMD}</code></pre>
          </div>
          <div class="overflow-hidden rounded-xl border border-border bg-background">
            <div class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-3">
              <p class="font-mono text-xs font-semibold text-muted-foreground">Server URL · every other client</p>
              <button class="copy-btn font-mono text-xs text-brand-violet hover:underline" data-copy={MCP_URL} title="Copy URL">Copy</button>
            </div>
            <pre class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-relaxed"><code>{MCP_URL}</code></pre>
          </div>
        </div>
        <p class="mt-4 max-w-[80ch] text-xs leading-relaxed text-muted-foreground">
          Requirements: an active Social+ plan and whatever credentials your Continuum
          workspace issued. Verify with <code class="font-mono text-[12px]">/mcp</code> in
          Claude Code or the connector list in Claude Desktop.
        </p>
      </section>

      <!-- 02 Capabilities -->
      <section class="mt-20 md:mt-28" aria-labelledby="tools-title">
        <p class="font-display text-base font-semibold text-brand-violet">02 · Capabilities</p>
        <h2 id="tools-title" class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">What the connector can do.</h2>
        <p class="mt-3 max-w-[46ch] text-lead text-muted-foreground">One workflow: from signal to asset to schedule to spend.</p>
        <div class="mt-8 overflow-hidden rounded-xl border border-border bg-background">
          <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-4 border-b border-border bg-muted/40 px-5 py-3 text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">
            <span>Capability</span><span>What it does</span>
          </div>
          <dl>
            {capabilities.map((t) => (
              <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-4 border-b border-border/60 px-5 py-4 last:border-0">
                <dt class="text-sm font-semibold">{t.name}</dt>
                <dd class="text-sm text-muted-foreground">{t.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- 03 Prompts -->
      <section class="mt-20 md:mt-28" aria-labelledby="prompts-title">
        <p class="font-display text-base font-semibold text-brand-violet">03 · Try it</p>
        <h2 id="prompts-title" class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">Copy, paste, post.</h2>
        <p class="mt-3 max-w-[46ch] text-lead text-muted-foreground">Four prompts that cover the whole loop. Paste them straight into Claude.</p>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {prompts.map((p) => (
            <div class="group rounded-xl border border-border bg-background p-6">
              <div class="flex items-center justify-between gap-4">
                <p class="font-display text-lg font-bold">{p.title}</p>
                <button class="copy-btn shrink-0 font-mono text-xs text-brand-violet hover:underline" data-copy={p.body} title="Copy prompt">Copy</button>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{p.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 04 Modules -->
      <section class="mt-20 md:mt-28" aria-labelledby="modules-title">
        <p class="font-display text-base font-semibold text-brand-violet">04 · Under the hood</p>
        <h2 id="modules-title" class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">The product behind the connector.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div class="rounded-xl border border-border bg-background p-6">
            <p class="font-mono text-xs font-semibold text-brand-violet">Signal Radar · Add-on $9.99/mo</p>
            <p class="mt-2 font-display text-xl font-bold">Never miss the signal.</p>
            <p class="mt-2 text-sm text-muted-foreground">Social listening, keywords, hashtags, plus weather, sports, and pop culture — segmented by country, city, and category.</p>
          </div>
          <div class="rounded-xl border border-border bg-background p-6">
            <p class="font-mono text-xs font-semibold text-brand-violet">Visual Lab · included</p>
            <p class="mt-2 font-display text-xl font-bold">From idea to on-brand asset.</p>
            <p class="mt-2 text-sm text-muted-foreground">AI image and video generation that respects your brand guidelines, in 1:1, 9:16, and 16:9. Generations billed in credits.</p>
          </div>
          <div class="rounded-xl border border-border bg-background p-6">
            <p class="font-mono text-xs font-semibold text-brand-violet">Editorial Calendar · included</p>
            <p class="mt-2 font-display text-xl font-bold">Signals become a schedule.</p>
            <p class="mt-2 text-sm text-muted-foreground">Execution-ready weekly planning for Instagram and LinkedIn — draft, ready, published, with full traceability.</p>
          </div>
          <div class="rounded-xl border border-border bg-background p-6">
            <p class="font-mono text-xs font-semibold text-brand-violet">Jaina · upgrade</p>
            <p class="mt-2 font-display text-xl font-bold">Paid media copilot.</p>
            <p class="mt-2 text-sm text-muted-foreground">Reads campaign performance, names the winners, and drafts the next move — applied only after you approve.</p>
          </div>
        </div>
      </section>

      <!-- 05 Pricing -->
      <section class="mt-20 md:mt-28" aria-labelledby="pricing-title">
        <p class="font-display text-base font-semibold text-brand-violet">05 · Pricing</p>
        <h2 id="pricing-title" class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">Simple pricing. Serious output.</h2>
        <p class="mt-3 max-w-[46ch] text-lead text-muted-foreground">One base subscription. Add what you need. Pay for what you generate.</p>
        <div class="mt-8 grid gap-4 lg:grid-cols-3">
          <div class="rounded-xl border border-brand-violet/40 bg-background p-6">
            <p class="font-mono text-xs font-semibold text-brand-violet">Base plan</p>
            <p class="mt-2 font-display text-2xl font-bold">Social+ · $19.99/mo</p>
            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              <li>Visual Lab image + video generation</li>
              <li>Editorial calendar + tracking flow</li>
              <li>5 seats · cancel anytime</li>
            </ul>
          </div>
          <div class="rounded-xl border border-border bg-background p-6">
            <p class="font-mono text-xs font-semibold text-muted-foreground">Add-on</p>
            <p class="mt-2 font-display text-2xl font-bold">Trends · $9.99/mo</p>
            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              <li>Full Signal Radar access</li>
              <li>Geo-segmentation + live opportunities</li>
              <li>Requires the base plan</li>
            </ul>
          </div>
          <div class="rounded-xl border border-border bg-background p-6">
            <p class="font-mono text-xs font-semibold text-muted-foreground">Pay-as-you-go</p>
            <p class="mt-2 font-display text-2xl font-bold">AI Studio credits</p>
            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              <li>Blocks of generation credits</li>
              <li>Never expire while base is active</li>
              <li>Scale with campaign size</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 06 Troubleshooting -->
      <section class="mt-20 md:mt-28" aria-labelledby="fix-title">
        <p class="font-display text-base font-semibold text-brand-violet">06 · Troubleshooting</p>
        <h2 id="fix-title" class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">Stuck? Check these first.</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {[
            ['Connector not listed', 'Restart the host after adding the connector, then check /mcp or the connector list.'],
            ['Connection fails', 'Confirm the endpoint is exactly https://api.trycontinuum.ai/mcp/v2 — including the /v2 — with no trailing slash.'],
            ['401 / unauthorized', 'Your workspace needs an active Social+ plan and the credentials Continuum issued for it.'],
            ['Tools return empty', 'Reconnect the server and confirm your brand workspace is selected.'],
          ].map(([t, b]) => (
            <li class="rounded-xl border border-border bg-background p-6">
              <p class="font-display text-lg font-bold">{t}</p>
              <p class="mt-2 text-sm text-muted-foreground">{b}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <div class="horizon horizon-dusk" aria-hidden="true"></div>

  <!-- Night close -->
  <div class="dark bg-[var(--night)] text-white">
    <section class="px-4 py-24 text-center md:px-6 md:py-32">
      <h2 class="mx-auto max-w-3xl text-balance font-display text-h2 font-bold">Connected? Make something.</h2>
      <p class="mx-auto mt-5 max-w-[46ch] text-lead text-white/70">
        Questions about setup or plans — talk to us and we'll get you posting.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <ShimmerButton
          href="mailto:michelle@continuumai.agency"
          shimmerColor="oklch(94% 0.08 195)"
          borderRadius="12px"
          background="linear-gradient(135deg, oklch(52% 0.13 205), oklch(42% 0.2 285))"
          className="btn-fill h-14 px-9 text-lg font-semibold [--btn-fill:oklch(40%_0.19_272)] shadow-[0_0_48px_-8px_oklch(80%_0.14_195/0.55)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          Email Michelle
        </ShimmerButton>
        <a href="https://wa.me/5491161991009" class="text-base font-medium text-white/75 underline-offset-4 transition-colors hover:text-white hover:underline">
          WhatsApp
        </a>
      </div>
    </section>
    <Footer />
  </div>
</Layout>

<script>
  const copyButtons = document.querySelectorAll('.copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        const el = btn as HTMLElement;
        const original = el.innerHTML;
        el.innerHTML = '✓';
        setTimeout(() => { el.innerHTML = original; }, 1500);
      }
    });
  });
</script>

<script>
  document.getElementById("sp-year")!.textContent = new Date().getFullYear().toString();

  // Copy command button
  document.querySelectorAll<HTMLButtonElement>(".sp-cmd-copy").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.dataset.cmd || "";
      navigator.clipboard.writeText(cmd).then(() => {
        btn.textContent = "✓";
        btn.style.color = "var(--sp-accent)";
        btn.style.borderColor = "var(--sp-accent)";
        setTimeout(() => {
          btn.textContent = "⧉";
          btn.style.color = "";
          btn.style.borderColor = "";
        }, 2000);
      });
    });
  });

  // Scroll reveals
  import { inView, animate, stagger } from "motion";

  document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => {
    el.style.opacity = "0";
    el.style.transform = "translateY(32px)";
    inView(el, () => {
      animate(
        el,
        { opacity: [0, 1], transform: ["translateY(32px)", "translateY(0px)"] },
        { duration: 0.7, easing: [0.16, 1, 0.3, 1] }
      );
    }, { amount: 0.1 });
  });

  // Stagger grid children
  (["sp-solves-grid", "sp-brand-steps", "sp-metrics-inner"] as const).forEach((cls) => {
    const grid = document.querySelector<HTMLElement>(`.${cls}`);
    if (!grid) return;
    Array.from(grid.children).forEach((child) => {
      (child as HTMLElement).style.opacity = "0";
    });
    inView(grid, () => {
      animate(
        Array.from(grid.children) as HTMLElement[],
        { opacity: [0, 1], transform: ["translateY(16px)", "translateY(0px)"] },
        { duration: 0.5, delay: stagger(0.08), easing: [0.16, 1, 0.3, 1] }
      );
    }, { amount: 0.1 });
  });
</script>

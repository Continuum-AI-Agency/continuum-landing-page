---
import Layout from '../layouts/Layout.astro';
import { VisualLabCanvas } from '../components/react/VisualLabCanvas';
---

<Layout
  title="Social+ — AI Community Management Plugin for Claude · Continuum"
  description="Social+ is a Claude plugin for AI-powered community management. Detect trends, generate brand-aligned content, and plan your editorial calendar — all inside Claude."
>
  <div class="relative min-h-screen bg-background text-foreground font-sans selection:bg-primary/20 selection:text-primary">
    <!-- Nav -->
    <nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 border-b border-border/10 bg-background/80 backdrop-blur-md transition-colors duration-normal ease-standard">
      <a href="/" class="group flex items-center gap-2 font-display text-[10px] tracking-[0.25em] text-foreground hover:text-primary transition-colors duration-fast ease-standard uppercase">
        <span class="text-muted-foreground/40 group-hover:text-primary group-hover:-translate-x-0.5 transition-all duration-fast">←</span>
        Continuum
      </a>
      <span class="font-sans text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-3 py-1 rounded-full bg-card/40 uppercase">
        Social+
      </span>
    </nav>

    <!-- Hero Section -->
    <section class="relative overflow-hidden py-24 md:py-32 border-b border-border/10">
      <!-- Grid Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-[0.07] pointer-events-none"></div>

      <!-- Concentric Orbital (Accretion Disk) background detail -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] pointer-events-none opacity-[0.05] mix-blend-screen">
        <svg viewBox="0 0 200 200" class="w-full h-full animate-[spin_240s_linear_infinite]" aria-hidden="true">
          <circle cx="100" cy="100" r="85" stroke="currentColor" class="text-brand-violet" stroke-width="0.1" fill="none" stroke-dasharray="3 9" />
          <circle cx="100" cy="100" r="70" stroke="currentColor" class="text-primary" stroke-width="0.15" fill="none" />
          <circle cx="100" cy="100" r="55" stroke="currentColor" class="text-brand-violet" stroke-width="0.2" fill="none" stroke-dasharray="1 15" />
        </svg>
      </div>

      <div class="max-w-6xl mx-auto px-6 relative z-10 flex flex-col items-center text-center">
        <p class="font-sans text-[10px] font-bold tracking-[0.25em] text-primary mb-6 uppercase">
          Continuum / Social+
        </p>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[0.95] text-foreground mb-4 max-w-4xl uppercase">
          Social<span class="text-brand-violet font-sans font-light">+</span><br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-foreground)]">for Claude.</span>
        </h1>
        <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground/60 font-semibold font-mono mb-8">Install once. Post on autopilot.</p>
        
        <p class="text-base md:text-lg text-muted-foreground max-w-[65ch] leading-relaxed mb-16 font-sans">
          Social+ brings trend detection, brand-aligned content creation, and editorial
          planning directly into <a href="https://github.com/anthropics/claude-code" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">Claude Code</a> and <a href="https://docs.anthropic.com/en/docs/welcome" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">Claude Desktop</a>. One plugin. Your entire social workflow, powered by our core <a href="/technology" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">design automation engine</a>.
        </p>

        <!-- MCP Installation Panel (Accretion Disk layout with Liquid Glass Refraction) -->
        <div class="w-full max-w-xl mb-16 text-left">
          <!-- Claude Desktop block -->
          <div class="relative overflow-hidden bg-card/40 border border-border/10 p-6 rounded-xl flex flex-col justify-between shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div>
              <div class="flex items-center justify-between mb-4 border-b border-border/5 pb-3">
                <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">◈ Claude Desktop MCP</span>
                <span class="font-mono text-[9px] text-brand-violet bg-brand-violet/10 px-1.5 py-0.5 rounded">Desktop URL</span>
              </div>
              <p class="text-xs text-muted-foreground mb-4">Use the MCP endpoint URL below in your Claude Desktop configuration file to connect the Social+ plugin.</p>
            </div>
            <div class="flex items-center justify-between bg-background border border-border/10 rounded px-4 py-3 font-mono text-xs mb-3">
              <div class="flex items-center gap-2 truncate">
                <span class="text-brand-violet font-semibold">URL:</span>
                <code class="text-foreground select-all truncate">https://api.trycontinuum.ai/mcp</code>
              </div>
              <button class="copy-btn text-muted-foreground hover:text-brand-violet pl-3 transition-colors duration-fast cursor-pointer" data-copy="https://api.trycontinuum.ai/mcp" title="Copy URL">
                ⧉
              </button>
            </div>
            <details class="text-[10px] text-muted-foreground/60 hover:text-muted-foreground transition-colors cursor-pointer select-none">
              <summary class="font-sans font-medium focus:outline-none">View configuration snippet</summary>
              <div class="mt-2 bg-background p-3 border border-border/5 rounded text-[9px] leading-relaxed relative group">
                <button class="copy-btn absolute top-2 right-2 text-muted-foreground/60 hover:text-primary transition-colors cursor-pointer" data-copy={`"mcpServers": {
  "social-plus": {
    "command": "npx",
    "args": ["-y", "@continuum/social-plus"],
    "env": {
      "CONTINUUM_API_URL": "https://api.trycontinuum.ai/mcp"
    }
  }
}`} title="Copy config JSON">⧉</button>
                <pre class="overflow-x-auto text-muted-foreground font-mono">{`"mcpServers": {
  "social-plus": {
    "command": "npx",
    "args": ["-y", "@continuum/social-plus"],
    "env": {
      "CONTINUUM_API_URL": "https://api.trycontinuum.ai/mcp"
    }
  }
}`}</pre>
              </div>
            </details>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-brand-violet/20 to-transparent"></div>
          </div>
        </div>

        <!-- Stats Grid (Tonal Cards with Liquid Glass Refraction) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-4xl">
          <div class="relative overflow-hidden bg-card/45 border border-border/10 p-5 rounded-lg flex flex-col items-center justify-center transition-all duration-normal hover:bg-card/65 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-xl font-bold tracking-tight text-foreground">01</span>
            <span class="font-sans text-[8px] font-bold tracking-[0.15em] text-muted-foreground uppercase mt-2">Trends · $9.99 Add-on</span>
          </div>
          <div class="relative overflow-hidden bg-card/45 border border-border/10 p-5 rounded-lg flex flex-col items-center justify-center transition-all duration-normal hover:bg-card/65 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-xl font-bold tracking-tight text-foreground">02</span>
            <span class="font-sans text-[8px] font-bold tracking-[0.15em] text-muted-foreground uppercase mt-2">Creative Studio</span>
          </div>
          <div class="relative overflow-hidden bg-card/45 border border-border/10 p-5 rounded-lg flex flex-col items-center justify-center transition-all duration-normal hover:bg-card/65 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-xl font-bold tracking-tight text-foreground">03</span>
            <span class="font-sans text-[8px] font-bold tracking-[0.15em] text-muted-foreground uppercase mt-2">Organic Planner</span>
          </div>
          <!-- Accent Card (Jaina) -->
          <div class="relative overflow-hidden bg-card/45 border border-primary/20 p-5 rounded-lg flex flex-col items-center justify-center transition-all duration-normal hover:bg-card/65 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-xl font-bold tracking-tight text-primary">04</span>
            <span class="font-sans text-[8px] font-bold tracking-[0.15em] text-primary uppercase mt-2">Jaina · Upgrade</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- WHAT SOCIAL+ SOLVES Section -->
    <section class="py-24 px-6 md:px-12 border-b border-border/10">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col items-center text-center mb-16">
          <p class="font-sans text-[10px] font-bold tracking-[0.25em] text-primary mb-4 uppercase">The Problem</p>
          <h2 class="font-sans text-4xl md:text-5xl font-bold tracking-tight leading-none text-foreground uppercase">
            What Social<span class="text-brand-violet font-sans font-light">+</span> Solves
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Item 1 -->
          <div class="relative overflow-hidden bg-card/30 border border-border/10 p-6 rounded-xl flex flex-col justify-between hover:bg-card/50 transition-all duration-normal shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div>
              <span class="font-mono text-xs font-bold text-primary block mb-4">01</span>
              <h3 class="font-sans text-sm font-bold tracking-wide text-foreground mb-3 uppercase">Fast, Brand-Aligned Content</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">The first flow builds your brand inside the system so everything created afterward is relevant and coherent from day one.</p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
          </div>
          <!-- Item 2 -->
          <div class="relative overflow-hidden bg-card/30 border border-border/10 p-6 rounded-xl flex flex-col justify-between hover:bg-card/50 transition-all duration-normal shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div>
              <span class="font-mono text-xs font-bold text-brand-violet block mb-4">02</span>
              <h3 class="font-sans text-sm font-bold tracking-wide text-foreground mb-3 uppercase">Signal-Based Decisions</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">Replace gut feeling with insights backed by social listening, market trends, and real external signals — not guesswork.</p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-brand-violet/20 to-transparent"></div>
          </div>
          <!-- Item 3 -->
          <div class="relative overflow-hidden bg-card/30 border border-border/10 p-6 rounded-xl flex flex-col justify-between hover:bg-card/50 transition-all duration-normal shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div>
              <span class="font-mono text-xs font-bold text-primary block mb-4">03</span>
              <h3 class="font-sans text-sm font-bold tracking-wide text-foreground mb-3 uppercase">Less Operational Friction</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">Centralize context, data, and assets so you can operate without jumping between tools. One place, all the intelligence.</p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
          </div>
          <!-- Item 4 -->
          <div class="relative overflow-hidden bg-card/30 border border-border/10 p-6 rounded-xl flex flex-col justify-between hover:bg-card/50 transition-all duration-normal shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div>
              <span class="font-mono text-xs font-bold text-brand-violet block mb-4">04</span>
              <h3 class="font-sans text-sm font-bold tracking-wide text-foreground mb-3 uppercase">From Insight to Execution</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">Turn signals into real content and an actionable editorial plan. No more analysis that never makes it to production.</p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-brand-violet/20 to-transparent"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- MODULE 01: SIGNAL RADAR -->
    <section class="py-24 px-6 md:px-12 border-b border-border/10" id="radar">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- Text Column -->
        <div class="flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-xs font-bold text-primary">01</span>
            <span class="text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-2 py-0.5 rounded-sm bg-card/40 uppercase">
              Signal Radar · Add-on
            </span>
          </div>
          <h2 class="font-sans text-4xl md:text-5xl font-bold tracking-tight leading-none text-foreground mb-6 uppercase">
            Signal<br />
            <span class="text-transparent [-webkit-text-stroke:1px_var(--color-foreground)]">Radar.</span>
          </h2>
          <p class="text-base text-muted-foreground max-w-[65ch] leading-relaxed mb-10 font-sans">
            Don't follow trends — master the signals impacting your industry before your competition even notices them.
          </p>

          <!-- Premium Data Spec List -->
          <div class="border border-border/10 rounded-xl overflow-hidden bg-card/20 backdrop-blur-sm shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 bg-card/30">
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Parameter</span>
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Value</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">SOCIAL LISTENING</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Topics, keywords, hashtags</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">EXTERNAL SIGNALS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Weather, sports, pop culture</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">SEGMENTATION</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Country, city, category</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">OUTPUT</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Prioritized opportunities</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">COVERAGE</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Retail, Fintech, Sports</span>
            </div>
          </div>
          <div class="mt-6 text-xs text-primary font-mono bg-primary/5 px-4 py-2 border border-primary/10 rounded w-fit uppercase font-semibold">
            Add-on · $9.99 / mo
          </div>
        </div>

        <!-- Visual Column (Concentric Radar Visual with rotating SVG details) -->
        <div class="relative w-full aspect-square max-w-[450px] mx-auto bg-card/5 rounded-2xl border border-border/5 p-6 shadow-inner flex flex-col justify-between">
          <div class="flex justify-between items-center mb-3">
            <span class="font-mono text-[9px] font-bold text-muted-foreground/60 uppercase">Signal Radar · Live Feed</span>
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-success rounded-full animate-ping"></span>
              <span class="font-sans text-[8px] font-bold text-success uppercase tracking-wider">Syncing</span>
            </span>
          </div>

          <!-- Concentric Radar Screen -->
          <div class="relative flex-1 w-full flex items-center justify-center bg-background/50 border border-border/10 rounded-lg overflow-hidden my-2">
            <!-- Telemetry SVG Background -->
            <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full text-border/15">
              <!-- Radial Lines (Crosshairs) -->
              <line x1="100" y1="10" x2="100" y2="190" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 3" />
              <line x1="10" y1="100" x2="190" y2="100" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 3" />
              
              <!-- Coordinate Grid Concentric Circles -->
              <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="0.5" fill="none" />
              <circle cx="100" cy="100" r="60" stroke="currentColor" stroke-width="0.5" fill="none" stroke-dasharray="4 4" />
              <circle cx="100" cy="100" r="40" stroke="currentColor" stroke-width="0.5" fill="none" />
              <circle cx="100" cy="100" r="20" stroke="currentColor" stroke-width="0.5" fill="none" stroke-dasharray="2 2" />

              <!-- Angle ticks and labels -->
              <text x="100" y="8" font-size="5" fill="currentColor" text-anchor="middle" font-family="monospace">000°</text>
              <text x="195" y="102" font-size="5" fill="currentColor" text-anchor="middle" font-family="monospace">090°</text>
              <text x="100" y="198" font-size="5" fill="currentColor" text-anchor="middle" font-family="monospace">180°</text>
              <text x="5" y="102" font-size="5" fill="currentColor" text-anchor="middle" font-family="monospace">270°</text>
            </svg>

            <!-- Sweep Radar Line using Conic Gradient -->
            <div class="absolute inset-0 origin-center animate-[spin_6s_linear_infinite] pointer-events-none">
              <div class="w-full h-full rounded-full bg-[conic-gradient(from_0deg,var(--color-primary)_0%,transparent_35%)] opacity-35 [mask-image:radial-gradient(circle,black_50%,transparent_100%)]"></div>
            </div>

            <!-- Sweep Overlay Ticks -->
            <div class="absolute inset-0 origin-center animate-[spin_6s_linear_infinite_reverse] pointer-events-none opacity-20">
              <svg viewBox="0 0 200 200" class="w-full h-full text-primary">
                <circle cx="100" cy="100" r="70" stroke="currentColor" stroke-width="0.75" fill="none" stroke-dasharray="1 18" />
              </svg>
            </div>

            <!-- Target Signals with Ripples and coordinates -->
            <!-- Target A: TRD-90 -->
            <div class="absolute top-[28%] left-[22%] flex flex-col items-center">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success shadow-[0_0_10px_var(--color-success)]"></span>
              </span>
              <div class="mt-1 bg-background/90 border border-border/10 px-1 py-0.5 rounded text-[6px] font-mono text-muted-foreground scale-90 uppercase tracking-tighter">
                TRD-90 · H
              </div>
            </div>

            <!-- Target B: CMP-14 -->
            <div class="absolute bottom-[30%] right-[20%] flex flex-col items-center">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-violet opacity-60"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-violet"></span>
              </span>
              <div class="mt-1 bg-background/90 border border-border/10 px-1 py-0.5 rounded text-[6px] font-mono text-muted-foreground scale-90 uppercase tracking-tighter">
                CMP-14 · M
              </div>
            </div>

            <!-- Target C: AUD-02 -->
            <div class="absolute top-[55%] right-[15%] flex flex-col items-center">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-60"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
              </span>
              <div class="mt-1 bg-background/90 border border-border/10 px-1 py-0.5 rounded text-[6px] font-mono text-muted-foreground scale-90 uppercase tracking-tighter">
                AUD-02 · L
              </div>
            </div>
          </div>

          <!-- Radar opportunity list -->
          <div class="grid grid-cols-2 gap-3 text-[10px] font-mono mt-2">
            <div class="bg-background/80 border border-border/10 p-2.5 rounded flex justify-between items-center">
              <span class="text-foreground/80 font-bold uppercase">Trending</span>
              <span class="text-success font-semibold">HIGH</span>
            </div>
            <div class="bg-background/80 border border-border/10 p-2.5 rounded flex justify-between items-center">
              <span class="text-foreground/80 font-bold uppercase">Competitor</span>
              <span class="text-warning font-semibold">WARN</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- MODULE 02: CREATIVE STUDIO -->
    <section class="py-24 px-6 md:px-12 bg-card/10 border-b border-border/10" id="studio">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- Visual Column (Visual Lab Mock) - Placed first on desktop -->
        <div class="order-last lg:order-first w-full max-w-[540px] mx-auto">
          <VisualLabCanvas client:load />
        </div>

        <!-- Text Column -->
        <div class="flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-xs font-bold text-primary">02</span>
            <span class="text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-2 py-0.5 rounded-sm bg-card/40 uppercase">
              Creative Studio
            </span>

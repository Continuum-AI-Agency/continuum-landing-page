---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Social+ — AI Community Management Plugin for Claude · Continuum"
  description="Social+ is a Claude plugin for AI-powered community management. Detect trends, generate brand-aligned content, and plan your editorial calendar — all inside Claude."
>
  <div class="sp-root">

    <!-- NAV -->
    <nav class="sp-nav">
      <a href="/" class="sp-nav-home">
        <span class="sp-nav-arrow">←</span>
        CONTINUUM
      </a>
      <span class="sp-nav-pill">SOCIAL+</span>
    </nav>

    <!-- HERO -->
    <section class="sp-hero">
      <div class="sp-grid-bg" aria-hidden="true"></div>
      <div class="sp-hero-inner reveal">
        <p class="sp-eyebrow">CONTINUUM / SOCIAL+</p>
        <h1 class="sp-hero-title">
          <span class="sr-only">AI Social Media Content Automation: </span>
          Social<span class="sp-accent-mark">+</span><br />
          for Claude.
        </h1>
        <p class="sp-hero-tagline">Install once. Post on autopilot.</p>
        <p class="sp-hero-sub">
          Social+ brings trend detection, brand-aligned content creation, and editorial
          planning directly into <a href="https://github.com/anthropics/claude-code" class="text-primary underline">Claude Code</a> and <a href="https://docs.anthropic.com/en/docs/welcome" class="text-primary underline">Claude Desktop</a>. One plugin. Your entire social workflow, powered by our core <a href="/technology" class="text-primary underline">design automation engine</a>.
        </p>

        <div class="sp-install-block">
          <div class="sp-install-header">
            <span>PLUGIN INSTALL</span>
            <span class="sp-install-ver">v1.0</span>
          </div>
          <div class="sp-install-row">
            <div class="sp-platform">
              <span class="sp-platform-glyph">⌨</span>
              <span class="sp-platform-label">CLAUDE CODE</span>
            </div>
            <div class="sp-cmd-line">
              <span class="sp-cmd-prompt">$</span>
              <code class="sp-cmd-text">claude mcp add @continuum/social-plus</code>
              <button class="sp-cmd-copy" data-cmd="claude mcp add @continuum/social-plus" aria-label="Copy command">⧉</button>
            </div>
          </div>
          <div class="sp-install-sep"></div>
          <div class="sp-install-row">
            <div class="sp-platform">
              <span class="sp-platform-glyph">◈</span>
              <span class="sp-platform-label">CLAUDE DESKTOP</span>
            </div>
            <a href="mailto:michelle@continuumai.agency" class="sp-request-link">Request access →</a>
          </div>
        </div>

        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">01</span>
            <span class="sp-stat-label">TRENDS · $9.99 ADD-ON</span>
          </div>
          <div class="sp-stat">
            <span class="sp-stat-num">02</span>
            <span class="sp-stat-label">CREATIVE STUDIO</span>
          </div>
          <div class="sp-stat">
            <span class="sp-stat-num">03</span>
            <span class="sp-stat-label">ORGANIC PLANNER</span>
          </div>
          <div class="sp-stat sp-stat--accent">
            <span class="sp-stat-num">04</span>
            <span class="sp-stat-label">JAINA · UPGRADE</span>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- WHAT SOCIAL+ SOLVES -->
    <section class="sp-solves">
      <div class="sp-solves-inner">
        <div class="sp-section-header">
          <p class="sp-eyebrow">THE PROBLEM</p>
          <h2 class="sp-section-title">What Social<span class="sp-accent-mark">+</span> solves</h2>
        </div>
        <div class="sp-solves-grid reveal">
          <div class="sp-solve-item">
            <span class="sp-solve-num">01</span>
            <h3 class="sp-solve-title">FAST, BRAND-ALIGNED CONTENT</h3>
            <p class="sp-solve-desc">The first flow builds your brand inside the system so everything created afterward is relevant and coherent from day one.</p>
          </div>
          <div class="sp-solve-item">
            <span class="sp-solve-num">02</span>
            <h3 class="sp-solve-title">SIGNAL-BASED DECISIONS</h3>
            <p class="sp-solve-desc">Replace gut feeling with insights backed by social listening, market trends, and real external signals — not guesswork.</p>
          </div>
          <div class="sp-solve-item">
            <span class="sp-solve-num">03</span>
            <h3 class="sp-solve-title">LESS OPERATIONAL FRICTION</h3>
            <p class="sp-solve-desc">Centralize context, data, and assets so you can operate without jumping between tools. One place, all the intelligence.</p>
          </div>
          <div class="sp-solve-item">
            <span class="sp-solve-num">04</span>
            <h3 class="sp-solve-title">FROM INSIGHT TO EXECUTION</h3>
            <p class="sp-solve-desc">Turn signals into real content and an actionable editorial plan. No more analysis that never makes it to production.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- MODULE 01: TRENDS ADD-ON -->
    <section class="sp-module" id="modules">
      <div class="sp-module-inner reveal">
        <div class="sp-module-text">
          <div class="sp-module-eyebrow">
            <span class="sp-module-num sp-module-num--active">02</span>
            <span class="sp-module-tag">TRENDS · ADD-ON</span>
          </div>
          <h2 class="sp-module-title">Signal<br /><em>Radar</em></h2>
          <p class="sp-module-desc">Don't follow trends — master the signals impacting your industry before your competition even notices them.</p>
          <div class="sp-specs">
            <div class="sp-spec-row"><span>SOCIAL LISTENING</span><span>Topics, keywords, hashtags</span></div>
            <div class="sp-spec-row"><span>EXTERNAL SIGNALS</span><span>Weather, sports, pop culture</span></div>
            <div class="sp-spec-row"><span>SEGMENTATION</span><span>Country, city, language, category</span></div>
            <div class="sp-spec-row"><span>OUTPUT</span><span>Prioritized opportunity list</span></div>
            <div class="sp-spec-row"><span>COVERAGE</span><span>Retail, Fintech, Sports + more</span></div>
          </div>
          <div class="sp-addon-inline">ADD-ON · <strong>$9.99 / mo</strong></div>
        </div>
        <div class="sp-visual sp-visual--radar">
          <div class="sp-radar-wrap">
            <div class="sp-radar-label">SIGNAL RADAR · LIVE</div>
            <div class="sp-radar-rings">
              <div class="sp-radar-ring sp-radar-ring--outer"></div>
              <div class="sp-radar-ring sp-radar-ring--mid"></div>
              <div class="sp-radar-ring sp-radar-ring--inner"></div>
              <div class="sp-radar-dot"></div>
            </div>
            <div class="sp-radar-signals">
              <div class="sp-signal-row sp-signal-row--hot">
                <span class="sp-signal-dot sp-signal-dot--active"></span>
                <span class="sp-signal-name">TRD</span>
                <span class="sp-signal-dots">· · · · · · ·</span>
                <span class="sp-signal-tag sp-signal-tag--high">HIGH</span>
              </div>
              <div class="sp-signal-row">
                <span class="sp-signal-dot"></span>
                <span class="sp-signal-name">CMP</span>
                <span class="sp-signal-dots">· · · · · ·</span>
                <span class="sp-signal-tag sp-signal-tag--med">MED</span>
              </div>
              <div class="sp-signal-row">
                <span class="sp-signal-dot"></span>
                <span class="sp-signal-name">AUD</span>
                <span class="sp-signal-dots">· · · · ·</span>
                <span class="sp-signal-tag">LOW</span>
              </div>
              <div class="sp-signal-row">
                <span class="sp-signal-dot"></span>
                <span class="sp-signal-name">EVT</span>
                <span class="sp-signal-dots">· · · · · · · ·</span>
                <span class="sp-signal-tag sp-signal-tag--high">HIGH</span>
              </div>
            </div>
            <div class="sp-radar-footer">
              <span>12 OPPORTUNITIES DETECTED</span>
              <span>USA · EN · FINTECH</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- MODULE 03: CREATIVE STUDIO -->
    <section class="sp-module sp-module--alt">
      <div class="sp-module-inner sp-module-inner--rev reveal">
        <div class="sp-module-text">
          <div class="sp-module-eyebrow">
            <span class="sp-module-num sp-module-num--active">03</span>
            <span class="sp-module-tag">CREATIVE STUDIO</span>
          </div>
          <h2 class="sp-module-title">Visual<br /><em>Lab</em></h2>
          <p class="sp-module-desc">From idea to brand-aligned content in minutes. AI-generated images and video that respect your brand guidelines every time.</p>
          <div class="sp-specs">
            <div class="sp-spec-row"><span>IMAGE GENERATION</span><span>Scenarios, product, lifestyle</span></div>
            <div class="sp-spec-row"><span>VIDEO GENERATION</span><span>Micro scenes, loops, mood</span></div>
            <div class="sp-spec-row"><span>CANVAS WORKFLOWS</span><span>5 sets per opportunity</span></div>
            <div class="sp-spec-row"><span>FORMATS</span><span>1:1 / 9:16 / 16:9 + variants</span></div>
            <div class="sp-spec-row"><span>CREDITS</span><span>Pay per generation · top up anytime</span></div>
          </div>
        </div>
        <div class="sp-visual sp-visual--canvas">
          <div class="sp-canvas-wrap">
            <div class="sp-canvas-titlebar">
              <div class="sp-canvas-dots">
                <span class="sp-cdot sp-cdot--r"></span>
                <span class="sp-cdot sp-cdot--y"></span>
                <span class="sp-cdot sp-cdot--g"></span>
              </div>
              <span class="sp-canvas-title">canvas_workflow_v3</span>
            </div>
            <div class="sp-canvas-body">
              <div class="sp-canvas-main">
                <div class="sp-canvas-toolbar">
                  <span class="sp-tool">T</span>
                  <span class="sp-tool">▣</span>
                  <span class="sp-tool">◎</span>
                  <span class="sp-tool">╱</span>
                  <span class="sp-tool sp-tool--active">✦</span>
                </div>
                <div class="sp-canvas-stage">
                  <div class="sp-canvas-bar sp-canvas-bar--full"></div>
                  <div class="sp-canvas-bar sp-canvas-bar--wide"></div>
                  <div class="sp-canvas-bar sp-canvas-bar--med"></div>
                  <div class="sp-canvas-thumb"></div>
                  <div class="sp-canvas-bar sp-canvas-bar--short"></div>
                </div>
                <div class="sp-canvas-footer-bar">
                  <span>FORMAT · 1080×1080</span>
                  <span>BATCH (24)</span>
                </div>
              </div>
              <div class="sp-canvas-layers">
                <div class="sp-layers-title">LAYERS</div>
                <div class="sp-layer sp-layer--active">
                  <span class="sp-layer-icon">▣</span>
                  <span>headline_v3</span>
                </div>
                <div class="sp-layer">
                  <span class="sp-layer-icon">▣</span>
                  <span>product_shot_r</span>
                </div>
                <div class="sp-layer">
                  <span class="sp-layer-icon">▣</span>
                  <span>bg_texture</span>
                </div>
                <div class="sp-layer sp-layer--dim">
                  <span class="sp-layer-icon">◎</span>
                  <span>logo_lockup</span>
                </div>
                <div class="sp-layer sp-layer--dim">
                  <span class="sp-layer-icon">◎</span>
                  <span>cta_block</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- MODULE 04: ORGANIC PLANNER -->
    <section class="sp-module">
      <div class="sp-module-inner reveal">
        <div class="sp-module-text">
          <div class="sp-module-eyebrow">
            <span class="sp-module-num sp-module-num--active">04</span>
            <span class="sp-module-tag">ORGANIC PLANNER</span>
          </div>
          <h2 class="sp-module-title">Editorial<br /><em>Calendar</em></h2>
          <p class="sp-module-desc">Execution-ready planning for Instagram and LinkedIn. What you detect becomes a calendar — it never stays just an analysis.</p>
          <div class="sp-specs">
            <div class="sp-spec-row"><span>CONVERSION</span><span>Insights → actionable calendar</span></div>
            <div class="sp-spec-row"><span>CADENCE</span><span>Steady weekly publishing rhythm</span></div>
            <div class="sp-spec-row"><span>POWERED BY</span><span>Trending Topics + briefs</span></div>
            <div class="sp-spec-row"><span>TRACEABILITY</span><span>Draft → ready → published</span></div>
            <div class="sp-spec-row"><span>HISTORY</span><span>Reuse + continuous learning</span></div>
          </div>
        </div>
        <div class="sp-visual sp-visual--calendar">
          <div class="sp-cal-wrap">
            <div class="sp-cal-header">
              <span class="sp-cal-month">ORGANIC PLANNER</span>
              <span class="sp-cal-range">APR 7–13</span>
            </div>
            <div class="sp-cal-weekdays">
              <span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span><span>SUN</span>
            </div>
            <div class="sp-cal-grid">
              <div class="sp-cal-day sp-cal-day--active">
                <span class="sp-cal-dot sp-cal-dot--scheduled"></span>
                <span class="sp-cal-platform">IG</span>
                <span class="sp-cal-status">DRAFT</span>
              </div>
              <div class="sp-cal-day"></div>
              <div class="sp-cal-day sp-cal-day--active">
                <span class="sp-cal-dot sp-cal-dot--scheduled"></span>
                <span class="sp-cal-platform">LI</span>
                <span class="sp-cal-status">READY</span>
              </div>
              <div class="sp-cal-day"></div>
              <div class="sp-cal-day sp-cal-day--active">
                <span class="sp-cal-dot sp-cal-dot--scheduled"></span>
                <span class="sp-cal-platform">TK</span>
                <span class="sp-cal-status">SCHED</span>
              </div>
              <div class="sp-cal-day"></div>
              <div class="sp-cal-day"></div>
              <div class="sp-cal-day"></div>
              <div class="sp-cal-day sp-cal-day--planned">
                <span class="sp-cal-dot"></span>
                <span class="sp-cal-platform">YT</span>
                <span class="sp-cal-status">PLAN</span>
              </div>
              <div class="sp-cal-day sp-cal-day--active">
                <span class="sp-cal-dot sp-cal-dot--scheduled"></span>
                <span class="sp-cal-platform">IG</span>
                <span class="sp-cal-status">READY</span>
              </div>
              <div class="sp-cal-day sp-cal-day--planned">
                <span class="sp-cal-dot"></span>
                <span class="sp-cal-platform">LI</span>
                <span class="sp-cal-status">PLAN</span>
              </div>
              <div class="sp-cal-day sp-cal-day--active">
                <span class="sp-cal-dot sp-cal-dot--scheduled"></span>
                <span class="sp-cal-platform">IG</span>
                <span class="sp-cal-status">SCHED</span>
              </div>
              <div class="sp-cal-day"></div>
              <div class="sp-cal-day sp-cal-day--active">
                <span class="sp-cal-dot sp-cal-dot--scheduled"></span>
                <span class="sp-cal-platform">YT</span>
                <span class="sp-cal-status">READY</span>
              </div>
            </div>
            <div class="sp-cal-legend">
              <span><span class="sp-legend-dot sp-legend-dot--scheduled"></span> SCHEDULED</span>
              <span><span class="sp-legend-dot sp-legend-dot--planned"></span> PLANNED</span>
              <span><span class="sp-legend-dot"></span> OPEN</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- JAINA: INCLUDED IN BASE -->
    <section class="sp-module sp-module--alt">
      <div class="sp-module-inner sp-module-inner--rev reveal">
        <div class="sp-module-text">
          <div class="sp-module-eyebrow">
            <span class="sp-module-num sp-module-num--active">+</span>
            <span class="sp-module-tag">JAINA · UPGRADE</span>
          </div>
          <h2 class="sp-module-title">Paid Media<br /><em>Copilot</em></h2>
          <p class="sp-module-desc">From performance data to an action plan. Jaina reads your campaigns, identifies what's working, and tells you exactly what to do next.</p>
          <div class="sp-specs">
            <div class="sp-spec-row"><span>PERFORMANCE REPORTING</span><span>Winning creatives + audiences</span></div>
            <div class="sp-spec-row"><span>CAMPAIGN PLANNING</span><span>Objectives, structure, budget</span></div>
            <div class="sp-spec-row"><span>STRATEGY ACTIVATION</span><span>Ready-to-launch action sets</span></div>
            <div class="sp-spec-row"><span>A/B TESTING</span><span>Suggested tests + iteration map</span></div>
            <div class="sp-spec-row"><span>OPTIMIZATION</span><span>Playbook + Q-roadmap</span></div>
          </div>
        </div>
        <div class="sp-visual sp-visual--dashboard">
          <div class="sp-dash-wrap">
            <div class="sp-dash-titlebar">
              <span class="sp-dash-name">JAINA · PAID MEDIA COPILOT</span>
              <span class="sp-dash-live">LIVE</span>
            </div>
            <div class="sp-dash-metrics">
              <div class="sp-dash-metric">
                <span class="sp-dash-val">4.2×</span>
                <span class="sp-dash-lbl">ROAS</span>
              </div>
              <div class="sp-dash-metric">
                <span class="sp-dash-val">$0.84</span>
                <span class="sp-dash-lbl">CPC</span>
              </div>
              <div class="sp-dash-metric">
                <span class="sp-dash-val">3.1%</span>
                <span class="sp-dash-lbl">CTR</span>
              </div>
              <div class="sp-dash-metric">
                <span class="sp-dash-val">$8.40</span>
                <span class="sp-dash-lbl">CPM</span>
              </div>
            </div>
            <div class="sp-dash-bars-label">CAMPAIGN PERFORMANCE</div>
            <div class="sp-dash-bars">
              <div class="sp-dash-bar-row">
                <span class="sp-dash-bar-name">SEARCH</span>
                <div class="sp-dash-bar-track">
                  <div class="sp-dash-bar-fill" style="width:68%"></div>
                </div>
                <span class="sp-dash-bar-pct">68%</span>
              </div>
              <div class="sp-dash-bar-row">
                <span class="sp-dash-bar-name">SOCIAL</span>
                <div class="sp-dash-bar-track">
                  <div class="sp-dash-bar-fill" style="width:44%"></div>
                </div>
                <span class="sp-dash-bar-pct">44%</span>
              </div>
              <div class="sp-dash-bar-row">
                <span class="sp-dash-bar-name">RETARGET</span>
                <div class="sp-dash-bar-track">
                  <div class="sp-dash-bar-fill sp-dash-bar-fill--accent" style="width:79%"></div>
                </div>
                <span class="sp-dash-bar-pct sp-dash-bar-pct--accent">79%</span>
              </div>
            </div>
            <div class="sp-dash-insight">
              <span class="sp-dash-insight-label">RECOMMENDATION</span>
              <p class="sp-dash-insight-text">Increase RETARGET budget by +15%. Creative A outperforms by 32%.<span class="sp-dash-cursor">▌</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- METRICS -->
    <section class="sp-metrics-section">
      <div class="sp-metrics-inner reveal">
        <div class="sp-metric">
          <span class="sp-metric-num sp-metric-num--accent">−60%</span>
          <span class="sp-metric-label">AD CREATION TIME</span>
          <span class="sp-metric-sub">Faster production using market signals</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num">10→4</span>
          <span class="sp-metric-label">CAMPAIGN WEEKS</span>
          <span class="sp-metric-sub">Timeline cut from 10 down to 4 weeks</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num sp-metric-num--accent">+35%</span>
          <span class="sp-metric-label">CONVERSION RATE</span>
          <span class="sp-metric-sub">Across strategic campaigns and ad sets</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num sp-metric-num--accent">+30%</span>
          <span class="sp-metric-label">ENGAGEMENT RATE</span>
          <span class="sp-metric-sub">vs. content without market signals</span>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- KPIs -->
    <section class="sp-kpis-section">
      <div class="sp-kpis-inner">
        <p class="sp-eyebrow" style="margin-bottom: 24px;">KPIs &amp; MEASUREMENT</p>
        <div class="sp-kpis-row reveal">
          <div class="sp-kpi">
            <span class="sp-kpi-label">TIME-TO-INSIGHT</span>
            <p class="sp-kpi-value">Speed from signal detection to a ready-to-act opportunity in your pipeline.</p>
          </div>
          <div class="sp-kpi">
            <span class="sp-kpi-label">ACTIVATION RATE</span>
            <p class="sp-kpi-value">Percentage of detected trends that actually become published content.</p>
          </div>
          <div class="sp-kpi">
            <span class="sp-kpi-label">CONSISTENCY</span>
            <p class="sp-kpi-value">Stability in publishing volume and format mix week over week.</p>
          </div>
          <div class="sp-kpi">
            <span class="sp-kpi-label">PERFORMANCE LIFT</span>
            <p class="sp-kpi-value">Engagement improvement vs. content created without market signals.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="sp-hatch"></div>

    <!-- PRICING -->
    <section class="sp-pricing-section">
      <div class="sp-pricing-inner">
        <div class="sp-section-header sp-section-header--center">
          <p class="sp-eyebrow">PRICING</p>
          <h2 class="sp-section-title">Simple pricing.<br />Serious output.</h2>
          <p class="sp-section-desc">One base subscription. Add what you need. Pay for what you generate.</p>
        </div>
        <div class="sp-pricing-cards reveal">

          <div class="sp-pricing-card sp-pricing-card--main">
            <div class="sp-card-badge">BASE PLAN</div>
            <p class="sp-plan-name">SOCIAL+</p>
            <div class="sp-plan-price-row">
              <span class="sp-plan-currency">$</span>
              <span class="sp-plan-price">19</span>
              <div class="sp-plan-price-right">
                <span class="sp-plan-cents">.99</span>
                <span class="sp-plan-per">/ mo</span>
              </div>
            </div>
            <p class="sp-plan-period">5 seats · cancel anytime</p>
            <div class="sp-plan-divider"></div>
            <ul class="sp-plan-features">
              <li class="sp-plan-feature sp-plan-feature--head">Creative Studio</li>
              <li class="sp-plan-feature">AI image &amp; video generation</li>
              <li class="sp-plan-feature">Canvas workflows &amp; multi-format variants</li>
              <li class="sp-plan-feature sp-plan-feature--head">Organic Planner</li>
              <li class="sp-plan-feature">Editorial calendar + draft → published</li>
              <li class="sp-plan-feature">Weekly cadence &amp; history</li>
            </ul>
            <a href="mailto:michelle@continuumai.agency" class="sp-btn sp-btn--filled">GET STARTED →</a>
          </div>

          <div class="sp-pricing-card">
            <div class="sp-card-badge sp-card-badge--blue">+ ADD-ON</div>
            <p class="sp-plan-name">TRENDS</p>

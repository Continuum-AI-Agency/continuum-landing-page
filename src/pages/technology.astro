---
import Layout from '../layouts/Layout.astro';
import Sky from '../components/Sky.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { ShimmerButton } from '../components/ui/shimmer-button';

const stats = [
  { value: '10K+', label: 'Variants per brief' },
  { value: '< 2s', label: 'Per variant' },
  { value: '100%', label: 'Brand-consistent' },
];

const chapters = [
  {
    id: 'ingest',
    index: '01',
    eyebrow: 'Ingest',
    title: 'Your design system becomes a production system.',
    lead: 'Brand books, templates, components, and After Effects projects are ingested once and ground every generation and render downstream — so scale never drifts off-brand.',
    specs: [
      ['Inputs', 'Brand books · templates · libraries'],
      ['Grounding', 'Every generation scoped to brand'],
      ['Multi-brand', 'Per-brand tenancy'],
      ['Versioning', 'Updates propagate downstream'],
      ['Readiness', 'AI-drafted brand book + score'],
    ],
  },
  {
    id: 'generate',
    index: '02',
    eyebrow: 'Generate',
    title: 'AI and rendering automation run as one pipeline.',
    lead: 'Node-based workflows draft image and video concepts while our auto-scaling render fleet finishes templates at production grade — and every variant passes brand validation before a human ever reviews it, including web accessibility standards like WCAG 2.1.',
    specs: [
      ['Generation', 'Image + video models on canvas'],
      ['Rendering', 'Auto-scaling AE render fleet'],
      ['Validation', '20+ brand checks per variant'],
      ['Throughput', '10K+ variants / day'],
      ['Formats', '30+ formats'],
    ],
  },
  {
    id: 'deliver',
    index: '03',
    eyebrow: 'Deliver',
    title: 'Finished creative goes straight into the ad set.',
    lead: 'Campaigns assembled through our DCO process, creatives switched on performance signals, results looped back into the next brief. Every channel, market, and audience. Zero manual reformatting.',
    specs: [
      ['Destinations', 'Meta · Google · TikTok · YouTube'],
      ['Delivery', 'Render-to-ad-set pipelines'],
      ['Optimization', 'DCO creative switching'],
      ['Approvals', 'Human gates where required'],
      ['Loop', 'Performance back into generation'],
    ],
  },
];
---

<Layout
  title="The Intelligent Creative Factory — Continuum AI Creative Platform"
  description="Continuum ingests your design system, generates on-brand creative between AI and rendering automations, and delivers it into every platform at scale through DCO."
  appearance="light"
>
  <Sky />
  <SiteNav />

  <!-- Night hero -->
  <section class="relative overflow-hidden bg-[var(--night)] pb-20 pt-32 text-white md:pb-28 md:pt-40">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <p class="font-display text-base font-semibold text-brand-violet">Continuum / Technology</p>
      <h1 class="mt-2 max-w-4xl text-balance font-display text-h2 font-bold">
        The Intelligent Creative Factory.
      </h1>
      <p class="mt-5 max-w-[46ch] text-lead text-white/70">
        We ingest your design system, generate on-brand content between AI and
        rendering automations, and deliver it into every platform at scale
        through DCO. Integrate with
        <a href="/social-plus" class="font-semibold text-white underline underline-offset-4 hover:text-white/80">Social+ for Claude</a>
        or see <a href="/#pricing" class="font-semibold text-white underline underline-offset-4 hover:text-white/80">pricing</a>.
      </p>
      <dl class="mt-12 grid max-w-3xl gap-4 sm:grid-cols-3">
        {stats.map((s) => (
          <div class="rounded-xl border border-white/10 bg-white/[0.04] p-6">
            <dd class="font-display text-4xl font-bold tabular-nums">{s.value}</dd>
            <dt class="mt-2 text-sm text-white/60">{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="horizon horizon-dawn" aria-hidden="true"></div>

  <!-- Daylight chapters -->
  <div class="bg-[linear-gradient(var(--day-top),var(--day-low))] text-foreground">
    <div class="mx-auto max-w-7xl px-4 py-24 md:px-6 md:py-32">
      <h2 class="max-w-3xl text-balance font-display text-h2 font-bold">Ingest. Generate. Deliver.</h2>
      <p class="mt-5 max-w-[46ch] text-lead text-muted-foreground">
        Three stages, one factory. Each stage runs on your design system and writes results back.
      </p>

      {chapters.map((c) => (
        <article id={c.id} class="mt-20 scroll-mt-24 md:mt-28" aria-labelledby={`${c.id}-title`}>
          <p class="font-display text-base font-semibold text-brand-violet">{c.index} · {c.eyebrow}</p>
          <h3 id={`${c.id}-title`} class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">{c.title}</h3>
          <p class="mt-3 max-w-[46ch] text-lead text-muted-foreground">
            {c.id === 'generate' ? (
              <>
                Node-based workflows draft image and video concepts while our auto-scaling render fleet
                finishes templates at production grade — and every variant passes brand validation before
                a human ever reviews it, including web accessibility standards like
                <a href="https://www.w3.org/WAI/standards-guidelines/wcag/" class="font-semibold text-brand-violet underline-offset-4 hover:underline"> WCAG 2.1</a>.
              </>
            ) : c.lead}
          </p>
          <div class="mt-8 overflow-hidden rounded-xl border border-border bg-background">
            <div class="grid grid-cols-2 gap-4 border-b border-border bg-muted/40 px-5 py-3 text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">
              <span>Parameter</span>
              <span class="text-right">Value</span>
            </div>
            <dl>
              {c.specs.map(([k, v]) => (
                <div class="grid grid-cols-2 items-center gap-4 border-b border-border/60 px-5 py-3.5 last:border-0">
                  <dt class="text-sm text-muted-foreground">{k}</dt>
                  <dd class="text-right font-mono text-[13px] font-medium">{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))}

      <!-- Validation console, kept from the previous page, restyled -->
      <article class="mt-20 md:mt-28" aria-label="Brand validation example">
        <p class="font-display text-base font-semibold text-brand-violet">Gate · Validation</p>
        <h3 class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">Every variant passes the gate before review.</h3>
        <p class="mt-3 max-w-[46ch] text-lead text-muted-foreground">16 variants checked against brand spec v4.2 in strict mode. 15 passed, 1 warning, 0 blocked.</p>
        <div class="mt-8 overflow-hidden rounded-xl border border-border bg-background font-mono text-[13px]">
          <div class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-3">
            <span class="text-xs text-muted-foreground">brand-check · batch_01J2K</span>
            <span class="rounded-full border border-brand-violet/30 bg-brand-violet/10 px-2.5 py-0.5 text-[11px] font-semibold text-brand-violet">Strict Mode</span>
          </div>
          <ul class="divide-y divide-border/60 px-5">
            <li class="flex items-center justify-between py-2.5"><span><span class="text-green-600">✓</span> BRAND_SCORE</span><span class="font-semibold">94 / 100 · Pass</span></li>
            <li class="flex items-center justify-between py-2.5"><span><span class="text-green-600">✓</span> TONE_CHECK</span><span class="font-semibold">Formal · Pass</span></li>
            <li class="flex items-center justify-between py-2.5"><span><span class="text-green-600">✓</span> COLOR_PALETTE</span><span class="font-semibold">Aligned · Pass</span></li>
            <li class="flex items-center justify-between py-2.5"><span><span class="text-green-600">✓</span> CONTRAST_RATIO</span><span class="font-semibold">8.2 : 1 · Pass</span></li>
            <li class="flex items-center justify-between py-2.5"><span><span class="text-amber-600">!</span> LOGO_CLEARANCE</span><span class="font-semibold">14px · Warn</span></li>
          </ul>
          <p class="border-t border-border bg-muted/40 px-5 py-3 text-xs text-muted-foreground">Batch validation complete — ready for the review queue.</p>
        </div>
      </article>

      <!-- Formats -->
      <article class="mt-20 md:mt-28" aria-label="Output formats">
        <p class="font-display text-base font-semibold text-brand-violet">Output · Every format</p>
        <h3 class="mt-1 max-w-3xl text-balance font-display text-h3 font-bold">Same brief. Every format.</h3>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {[
            ['9:16', 'Story', 'Tall crops for Reels, TikTok, Shorts.'],
            ['1:1', 'Feed', 'Square crops for Instagram and LinkedIn.'],
            ['16:9', 'Display', 'Landscape for YouTube and display.'],
          ].map(([ratio, name, body]) => (
            <div class="rounded-xl border border-border bg-background p-6">
              <p class="font-mono text-xs font-semibold text-brand-violet">{ratio}</p>
              <p class="mt-2 font-display text-xl font-bold">{name}</p>
              <p class="mt-2 text-sm text-muted-foreground">{body}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>

  <div class="horizon horizon-dusk" aria-hidden="true"></div>

  <!-- Night close -->
  <div class="dark bg-[var(--night)] text-white">
    <section class="px-4 py-24 text-center md:px-6 md:py-32">
      <h2 class="mx-auto max-w-3xl text-balance font-display text-h2 font-bold">Stand up your creative factory.</h2>
      <p class="mx-auto mt-5 max-w-[46ch] text-lead text-white/70">
        Tell us what you ship each week. We'll show you the line that ships it.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <ShimmerButton
          href="/#demo"
          shimmerColor="oklch(94% 0.08 195)"
          borderRadius="12px"
          background="linear-gradient(135deg, oklch(52% 0.13 205), oklch(42% 0.2 285))"
          className="btn-fill h-14 px-9 text-lg font-semibold [--btn-fill:oklch(40%_0.19_272)] shadow-[0_0_48px_-8px_oklch(80%_0.14_195/0.55)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          Book a demo
        </ShimmerButton>
        <a href="/" class="text-base font-medium text-white/75 underline-offset-4 transition-colors hover:text-white hover:underline">
          Back to site
        </a>
      </div>
    </section>
    <Footer />
  </div>
</Layout>

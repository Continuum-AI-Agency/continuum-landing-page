---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Design Automation at Scale — Continuum AI Creative Platform"
  description="Design automation at scale. Continuum generates, validates, and ships brand-consistent creative across every channel and format — automatically and at speed."
>
  <div class="relative min-h-screen bg-background text-foreground font-sans selection:bg-primary/20 selection:text-primary">
    <!-- Nav -->
    <nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 border-b border-border/10 bg-background/80 backdrop-blur-md transition-colors duration-normal ease-standard">
      <a href="/" class="group flex items-center gap-2 font-display text-[10px] tracking-[0.25em] text-foreground hover:text-primary transition-colors duration-fast ease-standard uppercase">
        <span class="text-muted-foreground/40 group-hover:text-primary group-hover:-translate-x-0.5 transition-all duration-fast">←</span>
        Continuum
      </a>
      <span class="font-sans text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-3 py-1 rounded-full bg-card/40 uppercase">
        Design Automation
      </span>
    </nav>

    <!-- Hero Section -->
    <section class="relative overflow-hidden py-24 md:py-32 border-b border-border/10">
      <!-- Grid Background Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-[0.07] pointer-events-none"></div>

      <!-- Concentric Orbital (Accretion Disk Metaphor) in background -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] pointer-events-none opacity-[0.06] mix-blend-screen">
        <svg viewBox="0 0 200 200" class="w-full h-full animate-[spin_180s_linear_infinite]" aria-hidden="true">
          <circle cx="100" cy="100" r="90" stroke="currentColor" class="text-primary" stroke-width="0.1" fill="none" stroke-dasharray="1 10" />
          <circle cx="100" cy="100" r="75" stroke="currentColor" class="text-brand-violet" stroke-width="0.15" fill="none" stroke-dasharray="5 5" />
          <circle cx="100" cy="100" r="60" stroke="currentColor" class="text-primary" stroke-width="0.1" fill="none" />
          <circle cx="100" cy="100" r="45" stroke="currentColor" class="text-brand-violet" stroke-width="0.2" fill="none" stroke-dasharray="2 15" />
          <circle cx="100" cy="100" r="30" stroke="currentColor" class="text-primary" stroke-width="0.1" fill="none" />
        </svg>
      </div>

      <div class="max-w-6xl mx-auto px-6 relative z-10 flex flex-col items-center text-center">
        <p class="font-sans text-[10px] font-bold tracking-[0.25em] text-primary mb-6 uppercase">
          Continuum / Design Automation
        </p>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[0.95] text-foreground mb-8 max-w-4xl uppercase">
          Design Automation<br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-foreground)]">at Scale.</span>
        </h1>
        <p class="text-base md:text-lg text-muted-foreground max-w-[65ch] leading-relaxed mb-16 font-sans">
          One design system. Infinite brand-consistent creative — generated,
          validated, and shipped automatically across every channel and format.
          Integrate with <a href="/social-plus" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">Social+ for Claude</a>
          or learn more about our <a href="/#pricing" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">pricing options</a>.
        </p>

        <!-- Stats Grid (Tonal Accretion Disk Cards with Liquid Glass Refraction) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-4xl">
          <!-- Stat 1 -->
          <div class="relative overflow-hidden bg-card/40 border border-border/10 p-8 rounded-xl flex flex-col items-center justify-center transition-all duration-normal ease-standard hover:bg-card/60 hover:border-border/20 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-4xl font-bold tracking-tight text-foreground tabular-nums">10K+</span>
            <span class="font-sans text-[9px] font-bold tracking-[0.2em] text-muted-foreground uppercase mt-3">Variants per Brief</span>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
          </div>
          <!-- Stat 2 -->
          <div class="relative overflow-hidden bg-card/40 border border-border/10 p-8 rounded-xl flex flex-col items-center justify-center transition-all duration-normal ease-standard hover:bg-card/60 hover:border-border/20 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-4xl font-bold tracking-tight text-foreground tabular-nums">&lt;&nbsp;2s</span>
            <span class="font-sans text-[9px] font-bold tracking-[0.2em] text-muted-foreground uppercase mt-3">Per Variant</span>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-brand-violet/20 to-transparent"></div>
          </div>
          <!-- Stat 3 -->
          <div class="relative overflow-hidden bg-card/40 border border-border/10 p-8 rounded-xl flex flex-col items-center justify-center transition-all duration-normal ease-standard hover:bg-card/60 hover:border-border/20 shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <span class="font-mono text-4xl font-bold tracking-tight text-foreground tabular-nums">100%</span>
            <span class="font-sans text-[9px] font-bold tracking-[0.2em] text-muted-foreground uppercase mt-3">Brand-Consistent</span>
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- 01 — SCALABLE Section -->
    <section class="py-24 px-6 md:px-12 border-b border-border/10">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- Text Column -->
        <div class="flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-xs font-bold text-primary">01</span>
            <span class="text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-2 py-0.5 rounded-sm bg-card/40 uppercase">
              Scalable
            </span>
          </div>
          <h2 class="font-sans text-4xl md:text-5xl font-bold tracking-tight leading-none text-foreground mb-6 uppercase">
            Scalable
          </h2>
          <p class="text-base text-muted-foreground max-w-[65ch] leading-relaxed mb-10 font-sans">
            From a single design system, Continuum produces thousands of on-brand
            variants — across every format, channel, and audience segment —
            without manual production. Scale is not a setting. It's the default.
          </p>

          <!-- Premium Data Spec List -->
          <div class="border border-border/10 rounded-xl overflow-hidden bg-card/20 backdrop-blur-sm shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 bg-card/30">
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Parameter</span>
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Value</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">VARIANTS PER BATCH</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Unlimited</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">PARALLEL RENDERS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Up to 500</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">FORMAT SUPPORT</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">30+ formats</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">BRAND RULE CHECKS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Per variant</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">THROUGHPUT</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">10K+ / day</span>
            </div>
          </div>
        </div>

        <!-- Visual Column (Accretion Disk Metaphor Simulation) -->
        <div class="relative w-full aspect-square max-w-[450px] mx-auto bg-card/5 rounded-2xl border border-border/5 overflow-hidden flex items-center justify-center p-8 shadow-inner">
          <!-- Background Orbit Path Grid -->
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-border)_1px,transparent_1px)] bg-[size:2rem_2rem] opacity-20 pointer-events-none"></div>

          <!-- Rotating Rings Container -->
          <div class="relative w-full h-full flex items-center justify-center">
            <!-- Gravity Well Core (Black Hole metaphor) -->
            <div class="relative w-28 h-28 rounded-full bg-background flex items-center justify-center shadow-2xl z-20 group cursor-pointer border border-primary/20">
              <!-- Event Horizon subtle line -->
              <div class="absolute inset-0 rounded-full border border-brand-violet/20 group-hover:border-primary/50 transition-colors duration-normal ease-standard"></div>
              <div class="w-20 h-20 rounded-full bg-radial from-background to-card border border-border/10 flex flex-col items-center justify-center text-center p-2">
                <span class="font-display text-[8px] font-bold tracking-[0.2em] text-primary uppercase">Core</span>
                <span class="font-mono text-[9px] text-muted-foreground/80 mt-1 uppercase">Event</span>
                <span class="font-mono text-[9px] text-muted-foreground/80 uppercase">Horizon</span>
              </div>
            </div>

            <!-- Accretion Disk Orbiting Ring 1 (Inner) -->
            <div class="absolute w-52 h-52 rounded-full border border-dashed border-border/10 flex items-center justify-center animate-[spin_30s_linear_infinite]">
              <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-primary text-[oklch(14%_0.01_265)] font-mono text-[9px] font-bold px-2 py-0.5 rounded shadow-sm hover:scale-105 transition-transform cursor-pointer animate-[spin_30s_linear_infinite_reverse]">
                v1.0.4
              </div>
              <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 bg-card border border-border/20 text-foreground font-mono text-[9px] px-2 py-0.5 rounded shadow-sm hover:scale-105 transition-transform cursor-pointer animate-[spin_30s_linear_infinite_reverse]">
                1:1 Crop
              </div>
            </div>

            <!-- Accretion Disk Orbiting Ring 2 (Middle) -->
            <div class="absolute w-72 h-72 rounded-full border border-dashed border-border/10 flex items-center justify-center animate-[spin_50s_linear_infinite_reverse]">
              <div class="absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-card border border-border/20 text-foreground font-mono text-[9px] px-2 py-0.5 rounded shadow-sm hover:scale-105 transition-transform cursor-pointer animate-[spin_50s_linear_infinite]">
                v2.1.0
              </div>
              <div class="absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2 bg-brand-violet text-foreground font-mono text-[9px] font-bold px-2 py-0.5 rounded shadow-sm hover:scale-105 transition-transform cursor-pointer animate-[spin_50s_linear_infinite]">
                Identity
              </div>
            </div>

            <!-- Accretion Disk Orbiting Ring 3 (Outer) -->
            <div class="absolute w-96 h-96 rounded-full border border-dashed border-border/5 flex items-center justify-center animate-[spin_85s_linear_infinite]">
              <div class="absolute top-1/4 left-6 bg-card border border-border/20 text-foreground font-mono text-[9px] px-2 py-0.5 rounded shadow-sm hover:scale-105 transition-transform cursor-pointer animate-[spin_85s_linear_infinite_reverse]">
                9:16 Crop
              </div>
              <div class="absolute bottom-1/4 right-6 bg-card border border-border/20 text-foreground font-mono text-[9px] px-2 py-0.5 rounded shadow-sm hover:scale-105 transition-transform cursor-pointer animate-[spin_85s_linear_infinite_reverse]">
                Meta API
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- 02 — TESTABLE Section -->
    <section class="py-24 px-6 md:px-12 bg-card/10 border-b border-border/10">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- Visual Column (Terminal Validation Console) - Placed first on large screen via order utility -->
        <div class="order-last lg:order-first w-full max-w-[500px] mx-auto bg-background border border-border/10 rounded-xl overflow-hidden shadow-2xl relative font-mono text-[11px] md:text-xs" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-card/60 border-b border-border/10">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-destructive/20 border border-destructive/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-warning/20 border border-warning/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-success/20 border border-success/40"></span>
              <span class="text-muted-foreground/60 text-[9px] font-bold tracking-wider uppercase ml-2">brand-check · batch_01J2K</span>
            </div>
            <span class="px-2 py-0.5 rounded text-[8px] font-bold bg-primary/10 border border-primary/20 text-primary uppercase font-sans">
              Strict Mode
            </span>
          </div>

          <!-- Terminal Content -->
          <div class="p-6 space-y-2.5 leading-relaxed text-muted-foreground/90 select-none">
            <!-- Command line -->
            <div class="flex items-center gap-2 text-foreground/80 mb-2">
              <span class="text-primary font-bold">continuum_agency ~</span>
              <span class="text-foreground">validate --batch 01J2K --strict</span>
            </div>
            
            <p class="text-muted-foreground/40 font-sans text-xs">Running 16 variants against brand spec v4.2...</p>
            <div class="h-1"></div>

            <!-- Parameter checks -->
            <div class="flex items-center justify-between border-b border-border/5 py-1">
              <div class="flex items-center gap-2">
                <span class="text-success font-semibold">✓</span>
                <span>BRAND_SCORE</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-muted-foreground/30">........................</span>
                <span class="font-semibold text-foreground">94 / 100</span>
                <span class="text-[9px] font-bold bg-success/15 border border-success/20 text-success px-1.5 py-0.2 rounded-sm">PASS</span>
              </div>
            </div>

            <div class="flex items-center justify-between border-b border-border/5 py-1">
              <div class="flex items-center gap-2">
                <span class="text-success font-semibold">✓</span>
                <span>TONE_CHECK</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-muted-foreground/30">........................</span>
                <span class="font-semibold text-foreground">FORMAL</span>
                <span class="text-[9px] font-bold bg-success/15 border border-success/20 text-success px-1.5 py-0.2 rounded-sm">PASS</span>
              </div>
            </div>

            <div class="flex items-center justify-between border-b border-border/5 py-1">
              <div class="flex items-center gap-2">
                <span class="text-success font-semibold">✓</span>
                <span>COLOR_PALETTE</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-muted-foreground/30">........................</span>
                <span class="font-semibold text-foreground">ALIGNED</span>
                <span class="text-[9px] font-bold bg-success/15 border border-success/20 text-success px-1.5 py-0.2 rounded-sm">PASS</span>
              </div>
            </div>

            <div class="flex items-center justify-between border-b border-border/5 py-1">
              <div class="flex items-center gap-2">
                <span class="text-success font-semibold">✓</span>
                <span>CONTRAST_RATIO</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-muted-foreground/30">........................</span>
                <span class="font-semibold text-foreground">8.2 : 1</span>
                <span class="text-[9px] font-bold bg-success/15 border border-success/20 text-success px-1.5 py-0.2 rounded-sm">PASS</span>
              </div>
            </div>

            <div class="flex items-center justify-between border-b border-border/5 py-1">
              <div class="flex items-center gap-2">
                <span class="text-warning font-semibold">!</span>
                <span>LOGO_CLEARANCE</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-muted-foreground/30">........................</span>
                <span class="font-semibold text-foreground">14px</span>
                <span class="text-[9px] font-bold bg-warning/15 border border-warning/20 text-warning px-1.5 py-0.2 rounded-sm">WARN</span>
              </div>
            </div>

            <div class="h-3"></div>
            <!-- Validation summary block -->
            <div class="border-l-2 border-primary bg-primary/5 px-4 py-2 rounded-r flex flex-col gap-1">
              <span class="text-primary font-bold uppercase tracking-wider text-[10px] font-sans">Batch Validation Complete</span>
              <span class="text-foreground/90 font-medium font-sans">15/16 passed · 1 warning · 0 blocked</span>
              <span class="text-muted-foreground/50 text-[10px] font-sans">Status: Ready for review queue.</span>
            </div>

            <div class="flex items-center gap-1 mt-3">
              <span class="text-primary font-bold">continuum_agency ~</span>
              <span class="w-1.5 h-3 bg-primary animate-pulse"></span>
            </div>
          </div>
        </div>

        <!-- Text Column -->
        <div class="flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-xs font-bold text-primary">02</span>
            <span class="text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-2 py-0.5 rounded-sm bg-card/40 uppercase">
              Testable
            </span>
          </div>
          <h2 class="font-sans text-4xl md:text-5xl font-bold tracking-tight leading-none text-foreground mb-6 uppercase">
            Testable
          </h2>
          <p class="text-base text-muted-foreground max-w-[65ch] leading-relaxed mb-10 font-sans">
            Every creative is automatically validated against your brand rules
            before it reaches a single reviewer. Automated scoring, approval gates,
            and regression testing are built into the generation pipeline — ensuring compliance with web accessibility standards like <a href="https://www.w3.org/WAI/standards-guidelines/wcag/" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">WCAG 2.1</a>.
          </p>

          <!-- Premium Data Spec List -->
          <div class="border border-border/10 rounded-xl overflow-hidden bg-card/20 backdrop-blur-sm shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 bg-card/30">
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Parameter</span>
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Configuration</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">BRAND SCORE GATE</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Configurable (/100)</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">VALIDATION CHECKS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">20+ per variant</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">BLOCKED AUTO-REGEN</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Yes</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">APPROVAL AUDIT LOG</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Immutable</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">REGRESSION TESTING</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Per system update</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- 03 — ADAPTABLE Section -->
    <section class="py-24 px-6 md:px-12 border-b border-border/10">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- Text Column -->
        <div class="flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-xs font-bold text-primary">03</span>
            <span class="text-[9px] font-bold tracking-[0.2em] text-muted-foreground border border-border/20 px-2 py-0.5 rounded-sm bg-card/40 uppercase">
              Adaptable
            </span>
          </div>
          <h2 class="font-sans text-4xl md:text-5xl font-bold tracking-tight leading-none text-foreground mb-6 uppercase">
            Adaptable
          </h2>
          <p class="text-base text-muted-foreground max-w-[65ch] leading-relaxed mb-10 font-sans">
            The same creative brief adapts to every channel, format, audience,
            and market — automatically. When your design system updates,
            every downstream variant regenerates. Zero manual reformatting.
          </p>

          <!-- Premium Data Spec List -->
          <div class="border border-border/10 rounded-xl overflow-hidden bg-card/20 backdrop-blur-sm shadow-sm" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 bg-card/30">
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Parameter</span>
              <span class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/60 uppercase">Capabilities</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">CHANNEL FORMATS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Social · Display · OOH · Video</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">LOCALIZATION</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">50+ languages</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">AUDIENCE VARIANTS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Per segment</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 border-b border-border/5 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">DESIGN SYSTEM SYNC</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">Real-time propagation</span>
            </div>
            <div class="flex justify-between items-center px-5 py-3 hover:bg-card/50 transition-colors duration-fast ease-standard">
              <span class="font-sans text-xs text-muted-foreground/80 tracking-wide">PLATFORM CONNECTORS</span>
              <span class="font-mono text-xs font-semibold text-foreground tracking-normal uppercase">30+ native</span>
            </div>
          </div>
        </div>

        <!-- Visual Column (Responsive Format Bento Grid) -->
        <div class="relative w-full max-w-[480px] mx-auto bg-card/5 rounded-2xl border border-border/5 p-6 shadow-inner flex flex-col gap-4">
          <!-- Bento Format grid layout representing Event Horizon crops -->
          <div class="grid grid-cols-3 gap-3 w-full">
            <!-- Story format (tall, spans 2 rows) -->
            <div class="col-span-1 row-span-2 relative overflow-hidden bg-card/45 border border-border/10 rounded-lg p-3 flex flex-col justify-between aspect-[9/16] shadow-sm hover:border-primary/30 hover:bg-card/65 transition-all duration-normal ease-standard group cursor-pointer" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
              <span class="font-mono text-[9px] font-bold text-muted-foreground/50 group-hover:text-primary transition-colors">9:16</span>
              <!-- Content Skeleton placeholder -->
              <div class="w-full flex-1 flex flex-col justify-end gap-2 mt-4">
                <div class="h-1.5 w-3/4 bg-border/20 rounded"></div>
                <div class="h-1.5 w-1/2 bg-border/20 rounded"></div>
                <div class="h-6 w-full bg-primary/10 border border-primary/20 rounded-sm mt-1"></div>
              </div>
              <span class="font-sans text-[8px] font-bold tracking-wider text-muted-foreground/75 mt-3 uppercase">Story</span>
            </div>

            <!-- Feed format (square) -->
            <div class="col-span-2 relative overflow-hidden bg-card/45 border border-border/10 rounded-lg p-3 flex flex-col justify-between aspect-square shadow-sm hover:border-primary/30 hover:bg-card/65 transition-all duration-normal ease-standard group cursor-pointer" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
              <div class="flex justify-between items-center">
                <span class="font-mono text-[9px] font-bold text-muted-foreground/50 group-hover:text-primary transition-colors">1:1</span>
                <span class="w-1.5 h-1.5 rounded-full bg-success/50"></span>
              </div>
              <!-- Skeleton placeholder -->
              <div class="w-full flex-1 flex flex-col justify-center gap-2 mt-2">
                <div class="w-full h-12 bg-border/10 rounded border border-border/5 flex items-center justify-center">
                  <div class="w-6 h-6 rounded-full border border-dashed border-border/30"></div>
                </div>
                <div class="h-1.5 w-2/3 bg-border/20 rounded"></div>
              </div>
              <span class="font-sans text-[8px] font-bold tracking-wider text-muted-foreground/75 mt-2 uppercase">Feed</span>
            </div>

            <!-- Display format (landscape) -->
            <div class="col-span-2 relative overflow-hidden bg-card/45 border border-border/10 rounded-lg p-3 flex flex-col justify-between aspect-[16/9] shadow-sm hover:border-primary/30 hover:bg-card/65 transition-all duration-normal ease-standard group cursor-pointer" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
              <span class="font-mono text-[9px] font-bold text-muted-foreground/50 group-hover:text-primary transition-colors">16:9</span>
              <div class="flex gap-2 items-center flex-1 my-2">
                <div class="w-10 h-full bg-border/10 rounded border border-border/5"></div>
                <div class="flex-1 flex flex-col gap-1.5">
                  <div class="h-1.5 w-full bg-border/20 rounded"></div>
                  <div class="h-1.5 w-2/3 bg-border/20 rounded"></div>
                </div>
              </div>
              <span class="font-sans text-[8px] font-bold tracking-wider text-muted-foreground/75 uppercase">Display</span>
            </div>

            <!-- Banner format (spanning bottom width) -->
            <div class="col-span-3 relative overflow-hidden bg-card/45 border border-border/10 rounded-lg p-2.5 flex items-center justify-between shadow-sm hover:border-primary/30 hover:bg-card/65 transition-all duration-normal ease-standard group cursor-pointer" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
              <div class="flex items-center gap-2">
                <span class="font-mono text-[9px] font-bold text-muted-foreground/50 group-hover:text-primary transition-colors">728:90</span>
                <span class="font-sans text-[8px] font-bold tracking-wider text-muted-foreground/75 uppercase">Leaderboard</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="h-1.5 w-16 bg-border/20 rounded"></div>
                <div class="h-5 w-16 bg-primary/10 border border-primary/20 rounded-sm"></div>
              </div>
            </div>
          </div>
          <p class="font-sans text-[10px] font-bold tracking-wider text-muted-foreground/50 text-center uppercase">
            Same brief. Every format.
          </p>
        </div>
      </div>
    </section>

    <!-- Hatch Transition Band -->
    <div class="h-8 border-y border-border/10 bg-[repeating-linear-gradient(-45deg,var(--color-border)_0,var(--color-border)_1px,transparent_1px,transparent_8px)] bg-background/30 opacity-70"></div>

    <!-- CTA Section -->
    <section class="relative py-24 px-6 md:px-12 bg-card/10 border-b border-border/10 text-center overflow-hidden">
      <!-- Grid backdrop subtle effect -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(circle_40%_at_50%_50%,#000_60%,transparent_100%)] opacity-[0.05] pointer-events-none"></div>

      <div class="max-w-3xl mx-auto relative z-10 flex flex-col items-center">
        <p class="font-sans text-[10px] font-bold tracking-[0.25em] text-primary mb-6 uppercase">
          Get Started
        </p>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-foreground mb-6 uppercase leading-none">
          Automate Your<br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-foreground)]">Design Pipeline.</span>
        </h2>
        <p class="text-base text-muted-foreground max-w-[60ch] leading-relaxed mb-10 font-sans">
          Get in touch with the Continuum team or discover our <a href="/#pricing" class="text-primary hover:text-[oklch(75%_0.13_180)] font-semibold underline underline-offset-4 decoration-primary/30 transition-colors">pricing models</a> to start building your brand's automated creative engine.
        </p>
        
        <div class="flex flex-wrap items-center justify-center gap-4">
          <!-- Request a Demo (Primary) -->
          <a href="/#demo" class="inline-flex items-center justify-center font-sans text-xs font-bold tracking-wider uppercase bg-primary text-primary-foreground px-8 py-3.5 rounded-md hover:bg-[oklch(75%_0.13_180)] hover:scale-[1.02] shadow-sm transition-all duration-normal ease-standard cursor-pointer" style="box-shadow: 0 1px 3px oklch(0% 0 0 / 40%), inset 0 1px 0 oklch(100% 0 0 / 8%)">
            Request a Demo
          </a>
          <!-- Back to Site (Outline) -->
          <a href="/" class="inline-flex items-center justify-center font-sans text-xs font-bold tracking-wider uppercase border border-border/20 text-foreground bg-transparent px-8 py-3.5 rounded-md hover:bg-card hover:border-border/40 transition-all duration-normal ease-standard cursor-pointer">
            Back to Site
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-7xl mx-auto py-8 px-6 md:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 font-sans text-[10px] font-bold tracking-wider text-muted-foreground/50 uppercase">
      <span>
        © {new Date().getFullYear()} Continuum. Made with love in Palo Alto, CA.
      </span>
      <a href="/" class="hover:text-primary transition-colors duration-fast ease-standard flex items-center gap-1.5">
        <span class="text-muted-foreground/30">←</span> Back to site
      </a>
    </footer>
  </div>
</Layout>

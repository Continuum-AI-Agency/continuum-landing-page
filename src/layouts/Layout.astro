---
import '../styles/global.css';

interface Props {
	title?: string;
}

const {
  title = "Continuum — Build continuity. Scale personalization.",
  description = "Continuum is the AI-powered platform that automates creative production and campaign activation end to end — built for modern brands that need performance at scale.",
  image = "/assets/Logo_Continuum (1).png",
  canonicalURL = new URL(Astro.url.pathname, "https://trycontinuum.ai")
} = Astro.props;

const buildDate = new Date().toISOString();
---

<!doctype html>
<html lang="en" class="dark">
	<head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <!-- Favicons -->
        <link rel="icon" type="image/png" href="/assets/Logo_Continuum (1).png" />
        <link rel="apple-touch-icon" href="/assets/Logo_Continuum (1).png" />

        <!-- SEO básico -->
        <meta name="description" content={description} />
        <meta name="keywords" content="AI creative production, campaign activation platform, personalized marketing, marketing automation, performance marketing, social creative automation" />
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />
        <meta property="og:site_name" content="Continuum" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <!-- Structured Data: JSON-LD -->
        <script type="application/ld+json" is:inline>
          {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "Continuum",
            "url": "https://trycontinuum.ai",
            "logo": "https://trycontinuum.ai/assets/Logo_Continuum (1).png",
            "description": "Continuum is the AI-powered platform that automates creative production and campaign activation end to end.",
            "sameAs": [
              "https://www.linkedin.com/company/continuum-agency"
            ]
          }
        </script>
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": title,
          "description": description,
          "url": canonicalURL.toString(),
          "datePublished": "2026-01-10T12:00:00Z",
          "dateModified": buildDate
        })} />

        <!-- Tema para navegadores -->
        <meta name="theme-color" content="#0f172a" />
	<body class="ch-body" id="top">
        <main class="ch-content-wrapper">
		    <slot />
        </main>
        <!-- main.js removed, scripts are now colocated in components -->
	</body>
</html>
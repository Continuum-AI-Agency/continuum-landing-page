# ZenBlog (headless CMS for /blog)
# Get this from the ZenBlog dashboard. The PUBLIC_ prefix exposes it to the
# client-side lazy loaders (BlogLazyList, RelatedPosts), which call the
# ZenBlog public API directly. The ID is public by design (it appears in API URLs).
PUBLIC_ZENBLOG_BLOG_ID=your-blog-id-here
